+/* (longshot) Optional console/PTX m16n8k16 fragment layout for the f16
+ * cooperative matrices Longshot probes for.  This is kept separate from the
+ * native Intel layout so no existing title changes behaviour. */
+static bool
+cmat_wants_ptx_layout(const struct glsl_cmat_description *desc,
+                      enum glsl_matrix_layout layout)
+{
+   return debug_get_bool_option("INTEL_COOPMAT_PTX", false) &&
+          desc->element_type == GLSL_TYPE_FLOAT16 && desc->rows == 16 &&
+          (desc->cols == 16 || desc->cols == 8) &&
+          layout == GLSL_MATRIX_LAYOUT_ROW_MAJOR;
+}
+
+static nir_def *
+cmat_elem_load(nir_builder *b, nir_deref_instr *ptr, nir_def *index)
+{
+   nir_deref_instr *d = nir_build_deref_ptr_as_array(b, ptr,
+      nir_i2iN(b, index, ptr->def.bit_size));
+   return nir_load_deref(b, d);
+}
+
+static void
+cmat_elem_store(nir_builder *b, nir_deref_instr *ptr, nir_def *index,
+                nir_def *value)
+{
+   nir_deref_instr *d = nir_build_deref_ptr_as_array(b, ptr,
+      nir_i2iN(b, index, ptr->def.bit_size));
+   nir_store_deref(b, d, value, 0x1);
+}
+
+static nir_def *
+cmat_pack2(nir_builder *b, nir_def *lo, nir_def *hi)
+{
+   nir_def *v[2] = { lo, hi };
+   return nir_pack_bits(b, nir_vec(b, v, 2), 32);
+}
