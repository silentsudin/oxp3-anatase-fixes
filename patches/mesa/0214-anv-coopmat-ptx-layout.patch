+/* ---- M=16, N=8 f16 cooperative-matrix lowering ----------------------
+ * Xe2 DPAS: D(M=8,N=16) = Ahw(8x16) * Bhw(16x16); M = repeat_count (max 8).
+ * A 16-row matrix therefore needs the swap trick:
+ *   Ahw[m][k] = B_long[k][m]      (B transposed, 8x16)
+ *   Bhw[k][n] = A_long[n][k]      (A transposed, 16x16)
+ *   D[m][n]   = C[n][m]           (D is C transposed, 8x16)
+ * All four conversions below are dword gathers out of the console/PTX-layout
+ * slices (the layout the PTX load/store branch produces).  The formulas come
+ * from the measured native hardware layouts:
+ *   A 8x16  lane t dword d: row t/8+4d, cols 2*(t%8)+{0,1}
+ *   B 16x16 lane t dword j: k=2*(t/16)+4j+{0,1}, n=t%16
+ *   C 8x16  lane t dword d: row t/8+4d, cols 2*(t%8)+{0,1}
+ * and the measured console layouts of the app slices.
+ */
+static nir_def *
+cmat_gather(nir_builder *b, nir_def *vec, nir_def *src_lane, nir_def *comp,
+            unsigned components)
+{
+   nir_def *res = nir_shuffle(b, nir_channel(b, vec, 0), src_lane);
+   for (unsigned c = 1; c < components; c++) {
+      nir_def *cand = nir_shuffle(b, nir_channel(b, vec, c), src_lane);
+      res = nir_bcsel(b, nir_ieq(b, comp, nir_imm_int(b, c)), cand, res);
+   }
+   return res;
+}
+
+static nir_def *
+cmat_half(nir_builder *b, nir_def *word, nir_def *half)
+{
+   nir_def *u = nir_unpack_bits(b, word, 16);
+   return nir_bcsel(b, nir_ieq_imm(b, half, 1),
+                    nir_channel(b, u, 1), nir_channel(b, u, 0));
+}
+
+
+/* B_long(console) -> hardware A 8x16 */
+static nir_def *
+cmat_swap_a(nir_builder *b, nir_def *B)
+{
+   nir_def *t = nir_load_subgroup_invocation(b);
+   nir_def *c = nir_umod_imm(b, t, 8);
+   nir_def *i3 = nir_iand_imm(b, c, 3);
+   nir_def *dw = nir_ushr_imm(b, c, 2);
+   nir_def *out[2];
+   for (unsigned d = 0; d < 2; d++) {
+      nir_def *m = nir_iadd_imm(b, nir_udiv_imm(b, t, 8), 4 * d);
+      nir_def *lane = nir_iadd(b, nir_imul_imm(b, m, 4), i3);
+      out[d] = cmat_gather(b, B, lane, dw, 2);
+   }
+   return nir_vec(b, out, 2);
+}
+
+/* A_long(console) -> hardware B 16x16 VNNI */
+static nir_def *
+cmat_swap_b(nir_builder *b, nir_def *A)
+{
+   nir_def *t = nir_load_subgroup_invocation(b);
+   nir_def *n = nir_umod_imm(b, t, 16);            /* n */
+   nir_def *n8 = nir_umod_imm(b, t, 8);            /* n % 8 */
+   nir_def *t16 = nir_ushr_imm(b, t, 4);           /* n / 16 */
+   nir_def *out[4];
+   for (unsigned j = 0; j < 4; j++) {
+      nir_def *u = nir_iadd_imm(b, t16, 2 * j);
+      nir_def *i3 = nir_iand_imm(b, u, 3);
+      /* Console A dword = (row>=8) + 2*(col>=8): the n (row) term was
+       * missing before, so rows 8..15 were never read (n>=8 duplicated). */
+      nir_def *n_hi = nir_ushr_imm(b, n, 3);           /* n >= 8 */
+      nir_def *c_hi = nir_iand_imm(b, nir_ushr_imm(b, u, 2), 1);
+      nir_def *dw = nir_ior(b, n_hi, nir_ishl_imm(b, c_hi, 1));
+      nir_def *lane = nir_iadd(b, nir_imul_imm(b, n8, 4), i3);
+      out[j] = cmat_gather(b, A, lane, dw, 4);
+   }
+   return nir_vec(b, out, 4);
+}
+
+/* C_app(console) -> hardware accumulator D (8x16) */
+static nir_def *
+cmat_swap_acc(nir_builder *b, nir_def *C)
+{
+   nir_def *t = nir_load_subgroup_invocation(b);
+   nir_def *n0 = nir_imul_imm(b, nir_umod_imm(b, t, 8), 2);
+   nir_def *out[2];
+   for (unsigned d = 0; d < 2; d++) {
+      nir_def *m = nir_iadd_imm(b, nir_udiv_imm(b, t, 8), 4 * d);
+      nir_def *half = nir_iand_imm(b, m, 1);
+      nir_def *i3 = nir_iand_imm(b, nir_ushr_imm(b, nir_iand_imm(b, m, 7), 1), 3);
+      nir_def *v[2];
+      for (unsigned h = 0; h < 2; h++) {
+         nir_def *n = nir_iadd_imm(b, n0, h);
+         nir_def *lane = nir_iadd(b,
+            nir_imul_imm(b, nir_umod_imm(b, n, 8), 4), i3);
+         nir_def *dw = nir_ushr_imm(b, n, 3);
+         v[h] = cmat_half(b, cmat_gather(b, C, lane, dw, 2), half);
+      }
+      out[d] = cmat_pack2(b, v[0], v[1]);
+   }
+   return nir_vec(b, out, 2);
+}
+
+/* hardware D (8x16) -> C_app(console) */
+static nir_def *
+cmat_swap_result(nir_builder *b, nir_def *D)
+{
+   nir_def *t = nir_load_subgroup_invocation(b);
+   nir_def *g = nir_udiv_imm(b, t, 4);
+   nir_def *i = nir_umod_imm(b, t, 4);
+   nir_def *out[2];
+   for (unsigned j = 0; j < 2; j++) {
+      nir_def *r = nir_iadd_imm(b, g, 8 * j);
+      nir_def *half = nir_iand_imm(b, r, 1);
+      nir_def *ridx = nir_iand_imm(b, nir_ushr_imm(b, r, 1), 7);
+      nir_def *m0 = nir_imul_imm(b, i, 2);
+      nir_def *v[2];
+      for (unsigned h = 0; h < 2; h++) {
+         nir_def *m = nir_iadd_imm(b, m0, h);
+         nir_def *lane = nir_iadd(b,
+            nir_imul_imm(b, nir_iand_imm(b, m, 3), 8), ridx);
+         nir_def *dw = nir_ushr_imm(b, m, 2);
+         v[h] = cmat_half(b, cmat_gather(b, D, lane, dw, 2), half);
+      }
+      out[j] = cmat_pack2(b, v[0], v[1]);
+   }
+   return nir_vec(b, out, 2);
+}
