From daa925c3bc78697cc214317ee330a39d1acda19f Mon Sep 17 00:00:00 2001
From: Omar Rashwan <omar.rashwan@intel.com>
Date: Wed, 21 Oct 2026 18:27:22 +0000
Subject: [PATCH] anv: stricter check for companion_rcs_cmd_buffer when
 chaining

Signed-off-by: Omar Rashwan <omar.rashwan@intel.com>
Reviewed-by: Lionel Landwerlin <lionel.g.landwerlin@intel.com>
Closes: https://gitlab.freedesktop.org/mesa/mesa/-/work_items/16357
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45498>
---
 src/intel/vulkan/anv_private.h | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/intel/vulkan/anv_private.h b/src/intel/vulkan/anv_private.h
index f03d5b731636..97941f43d07d 100644
--- a/src/intel/vulkan/anv_private.h
+++ b/src/intel/vulkan/anv_private.h
@@ -5121,7 +5121,8 @@ anv_cmd_buffer_is_chainable(struct anv_cmd_buffer *cmd_buffer)
 {
    return !(cmd_buffer->usage_flags &
             VK_COMMAND_BUFFER_USAGE_SIMULTANEOUS_USE_BIT) &&
-          !(cmd_buffer->is_companion_rcs_cmd_buffer);
+          !(cmd_buffer->is_companion_rcs_cmd_buffer) &&
+          cmd_buffer->companion_rcs_cmd_buffer == NULL;
 }
 
 static inline bool
