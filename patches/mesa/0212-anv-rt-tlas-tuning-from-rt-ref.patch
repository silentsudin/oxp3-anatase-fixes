+
+/* --- ANV_BVH_TS: acceleration-structure build stage timer (docs section 156) ---
+ * PIPE_CONTROL WriteTimestamp at build start, encode-stage entry and build end,
+ * written into a host-visible BO ring (3 timestamps per build), aggregated
+ * in-process.  Measurement only: no command-stream or state changes.
+ */
+#define BVH_TS_BUILD_SLOTS 8
+
+static struct {
+   struct anv_bo *bo;
+   volatile uint64_t *map;
+   uint64_t freq;
+   bool init, enabled, encode_emitted;
+   unsigned slot;
+   uint64_t builds, infos, top, bottom;
+   uint64_t sum_total, sum_generic, sum_encode;
+   uint64_t first, last;
+} bvh_ts;
+
+static void
+bvh_ts_report(void)
+{
+   if (!bvh_ts.builds || !bvh_ts.freq)
+      return;
+   const double ms = 1000.0 / (double) bvh_ts.freq;
+   const double total = (double) bvh_ts.sum_total * ms;
+   const double span = (double) (bvh_ts.last - bvh_ts.first) * ms;
+   fprintf(stderr,
+           "BVHTS builds=%llu infos=%llu top=%llu bottom=%llu "
+           "total_build_ms=%.1f avg_us=%.1f generic_ms=%.1f encode_ms=%.1f "
+           "generic_us=%.1f encode_us=%.1f span_ms=%.1f share=%.1f%%\n",
+           (unsigned long long) bvh_ts.builds,
+           (unsigned long long) bvh_ts.infos,
+           (unsigned long long) bvh_ts.top,
+           (unsigned long long) bvh_ts.bottom,
+           total,
+           bvh_ts.builds ? total * 1000.0 / (double) bvh_ts.builds : 0.0,
+           (double) bvh_ts.sum_generic * ms,
+           (double) bvh_ts.sum_encode * ms,
+           bvh_ts.builds ? (double) bvh_ts.sum_generic * ms * 1000.0 / (double) bvh_ts.builds : 0.0,
+           bvh_ts.builds ? (double) bvh_ts.sum_encode * ms * 1000.0 / (double) bvh_ts.builds : 0.0,
+           span, span > 0.0 ? 100.0 * total / span : 0.0);
+}
+
+static void
+bvh_ts_init(struct anv_device *device)
+{
+   if (bvh_ts.init)
+      return;
+   bvh_ts.init = true;
+   if (getenv("ANV_BVH_TS") == NULL)
+      return;
+   if (anv_device_alloc_bo(device, "ANV_BVH_TS", 4096,
+                           ANV_BO_ALLOC_MAPPED | ANV_BO_ALLOC_HOST_COHERENT,
+                           0, &bvh_ts.bo) != VK_SUCCESS)
+      return;
+   bvh_ts.map = bvh_ts.bo->map;
+   bvh_ts.freq = device->info->timestamp_frequency;
+   bvh_ts.enabled = bvh_ts.freq != 0;
+   if (bvh_ts.enabled)
+      atexit(bvh_ts_report);
+}
+
+static void
+bvh_ts_emit(struct anv_cmd_buffer *cmd_buffer, unsigned offset_bytes)
+{
+   genX(batch_emit_pipe_control_write)(&cmd_buffer->batch,
+                                       cmd_buffer->device->info, 0,
+                                       WriteTimestamp,
+                                       (struct anv_address) {
+                                          .bo = bvh_ts.bo,
+                                          .offset = offset_bytes,
+                                       }, 0, 0, NULL);
+}
+
+static void
+bvh_ts_start(struct anv_cmd_buffer *cmd_buffer)
+{
+   if (!bvh_ts.enabled)
+      return;
+   const unsigned prev = ((bvh_ts.slot + BVH_TS_BUILD_SLOTS - 2) %
+                          BVH_TS_BUILD_SLOTS) * 3;
+   const uint64_t a = bvh_ts.map[prev + 0];
+   const uint64_t b = bvh_ts.map[prev + 1];
+   const uint64_t c = bvh_ts.map[prev + 2];
+   if (a && b && c && b >= a && c >= b) {
+      bvh_ts.sum_total   += c - a;
+      bvh_ts.sum_generic += b - a;
+      bvh_ts.sum_encode  += c - b;
+      bvh_ts.builds++;
+      if (bvh_ts.first == 0)
+         bvh_ts.first = a;
+      bvh_ts.last = c;
+   }
+   bvh_ts.encode_emitted = false;
+   bvh_ts_emit(cmd_buffer, bvh_ts.slot * 3 * sizeof(uint64_t));
+}
+
+static void
+bvh_ts_encode_entry(struct anv_cmd_buffer *cmd_buffer)
+{
+   if (!bvh_ts.enabled || bvh_ts.encode_emitted)
+      return;
+   bvh_ts.encode_emitted = true;
+   bvh_ts_emit(cmd_buffer, (bvh_ts.slot * 3 + 1) * sizeof(uint64_t));
+}
+
+static void
+bvh_ts_end(struct anv_cmd_buffer *cmd_buffer)
+{
+   if (!bvh_ts.enabled)
+      return;
+   bvh_ts_emit(cmd_buffer, (bvh_ts.slot * 3 + 2) * sizeof(uint64_t));
+   bvh_ts.slot = (bvh_ts.slot + 1) % BVH_TS_BUILD_SLOTS;
+}
