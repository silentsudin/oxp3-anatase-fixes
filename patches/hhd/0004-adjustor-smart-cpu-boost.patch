From 867fc317f12029b28ba12150ee866d1a8fc827c3 Mon Sep 17 00:00:00 2001
From: silentsudin <25103587+silentsudin@users.noreply.github.com>
Date: Fri, 27 Nov 2026 09:36:33 +0000
Subject: [PATCH] adjustor: Smart CPU boost - core clock caps that follow the
 load

CPU Boost in the manual energy settings gets a third choice next to
Disabled and Enabled. Smart keeps boost on and caps each core type
(told apart by base_frequency; only offered on Intel with exactly three
types), fastest first, at one of three levels:

  level 0  P 3.0, E 2.0, LP E 1.5 GHz
  level 1  P 3.8, E 2.8, LP E 1.5 GHz
  level 2  no caps (as Enabled)

At a fixed TDP the CPU and the GPU share one power budget. Uncapped
boost lets the E-cores take the GPU's share; boost off leaves the game's
main thread on a slow P-core. Level 0 is SimpleDeckyTDP-Intel's Smart
(kas5852), measured on the OneXPlayer 3 at 30 W: Resident Evil 4 1% low
+32-38 % with the average about flat against boost off, where uncapped
boost cost 12.9 %.

Fixed, those caps sit on the critical path of a CPU-bound game: Elden
Ring ran slower with them. So every 2 s (hhd's poll) Smart reads the
per-core load: a P- or E-core at >= 85 % busy at its cap raises the level
at once; the level drops only after three checks in which every core
would stay below 70 % at the lower caps (its load scaled by the clock
ratio), so a step down cannot bounce straight back up. The LP E-cores
do not decide: games run on the P- and E-cores, and background work on
the LP cores (Steam's shader pre-compilation) must not lift the caps.

The busiest thread decides as well as the busiest core. The scheduler
moves a saturated thread between cores, so its load is spread out and
no core reaches 85 %: in Elden Ring the main thread sat at 95 % of a
core across cpu0/1/4 while every core stayed below 70 %, and Smart kept
the P-cores at 3.8 GHz through every CPU-bound stretch. Each check reads
the per-process CPU time (about 7 ms for 550 processes) and the threads
of processes above half a core only.

The caps are applied after set_frequency_scaling(), which resets every
core's maximum, so Enabled, Disabled and the auto mode lift them again;
a wake-up re-applies the current level. The boost value is read as the
string it is (it was cast to bool and compared with "enabled").

The busiest thread steps down under a stricter bar than a core: its
predicted load at the lower caps must stay below 45 %, not 70 %. A
frame-capped main thread averages well below saturation while its heavy
frames do not. After the 2026-11-26 install made Elden Ring's main thread
cheaper (40-49 % of a core at 4.7 GHz, down from 56 % or more), the 70 %
bar let Smart step down to 3.0 GHz at every lull and start each heavy
scene capped. With 45 % the game holds level 2 as before, and light
GPU-bound titles (a 20-30 % main thread) still step down.
---
 adjustor/drivers/gpu/__init__.py  |  27 +++-
 adjustor/drivers/gpu/settings.yml |   6 +
 adjustor/fuse/gpu.py              | 255 ++++++++++++++++++++++++++++++
 3 files changed, 286 insertions(+), 2 deletions(-)

diff --git a/adjustor/drivers/gpu/__init__.py b/adjustor/drivers/gpu/__init__.py
index 03b5fcb..a7c322a 100644
--- a/adjustor/drivers/gpu/__init__.py
+++ b/adjustor/drivers/gpu/__init__.py
@@ -20,6 +20,8 @@ from adjustor.fuse.gpu import (
     set_powersave_governor,
     can_use_nonlinear,
     set_frequency_scaling,
+    SmartBoost,
+    supports_smart_boost,
 )
 
 logger = logging.getLogger(__name__)
@@ -108,6 +110,7 @@ class GpuPlugin(HHDPlugin):
         self.old_sched = "disabled"
         self.old_boost = None
         self.old_epp = None
+        self.smart = SmartBoost()
         self.old_target = None
         self.old_min_freq = None
         self.old_lpmd_mode = None
@@ -238,6 +241,10 @@ class GpuPlugin(HHDPlugin):
         if self.supports_boost:
             if not self.logged_boost:
                 logger.info(f"CPU Boost toggling is supported.")
+            if not supports_smart_boost():
+                del sets["enabled"]["children"]["mode"]["modes"]["manual"]["children"][
+                    "cpu_boost"
+                ]["options"]["smart"]
         else:
             if not self.logged_boost:
                 logger.warning(f"CPU Boost toggling is not supported.")
@@ -404,6 +411,7 @@ class GpuPlugin(HHDPlugin):
                 except Exception as e:
                     logger.error(f"Failed to set energy mode:\n{e}")
 
+            self.smart.stop()
             # Unless it is set manually, use the default scheduler.
             self.close_sched()
             self.old_sched = None
@@ -413,11 +421,12 @@ class GpuPlugin(HHDPlugin):
         else:
             self.old_target = None
             if self.supports_boost:
-                new_boost = conf["tdp.amd_energy.mode.manual.cpu_boost"].to(bool)
+                new_boost = conf["tdp.amd_energy.mode.manual.cpu_boost"].to(str)
                 if new_boost != self.old_boost or queue:
                     self.old_boost = new_boost
                     try:
-                        set_cpu_boost(new_boost == "enabled")
+                        set_cpu_boost(new_boost in ("enabled", "smart"))
+                        # resets every core's maximum, which also lifts Smart's caps
                         set_frequency_scaling(
                             nonlinear=self.supports_nonlinear
                             and conf.get(
@@ -425,8 +434,22 @@ class GpuPlugin(HHDPlugin):
                             )
                             == "nonlinear"
                         )
+                        if new_boost == "smart":
+                            # a new choice starts at level 0; a wake-up keeps the level
+                            if self.smart.last is None:
+                                self.smart.start(curr)
+                            else:
+                                self.smart.reapply()
+                        else:
+                            self.smart.stop()
                     except Exception as e:
                         logger.error(f"Failed to set CPU boost:\n{e}")
+                elif new_boost == "smart":
+                    try:
+                        self.smart.tick(curr)
+                    except Exception as e:
+                        logger.error(f"Smart CPU boost failed:\n{e}")
+                        self.smart.stop()
 
             if self.supports_epp:
                 new_epp = conf["tdp.amd_energy.mode.manual.cpu_pref"].to(str)
diff --git a/adjustor/drivers/gpu/settings.yml b/adjustor/drivers/gpu/settings.yml
index 4c6f5a0..5563092 100644
--- a/adjustor/drivers/gpu/settings.yml
+++ b/adjustor/drivers/gpu/settings.yml
@@ -60,8 +60,14 @@ enabled:
                 Enables or disables the CPU boost frequencies.
                 Disabling lowers total consumption by 2W with 
                 minimal performance impact.
+                Smart keeps boost on and caps each core type
+                (P 3.0, E 2.0, LP E 1.5 GHz) while the cores have
+                headroom, so the GPU keeps its share of the power.
+                When a core saturates the caps rise step by step,
+                up to none at all, so CPU-bound games are not held back.
               options:
                 disabled: Disabled
+                smart: Smart
                 enabled: Enabled
             lpmd:
               type: multiple
diff --git a/adjustor/fuse/gpu.py b/adjustor/fuse/gpu.py
index d8b736a..ed8da9e 100644
--- a/adjustor/fuse/gpu.py
+++ b/adjustor/fuse/gpu.py
@@ -39,6 +39,39 @@ CPU_FREQ_DRIVER_MAX_FN = "cpufreq/cpuinfo_max_freq"
 CPU_FREQ_NONLINEAR_MIN_FN = "cpufreq/amd_pstate_lowest_nonlinear_freq"
 CPU_FREQ_MAX_FN = "cpufreq/scaling_max_freq"
 CPU_FREQ_MIN_FN = "cpufreq/scaling_min_freq"
+CPU_BASE_FREQ_FN = "cpufreq/base_frequency"
+
+# Smart CPU boost: boost stays on, and each core type (P, E, LP E-cores, fastest first) gets a clock
+# cap that follows the load. At a fixed TDP the CPU and the GPU share one power budget: uncapped boost
+# lets the E-cores take the GPU's share, boost off leaves the game's main thread on a slow P-core.
+# Level 0 is SimpleDeckyTDP-Intel's Smart (kas5852), measured on the OneXPlayer 3 at 30 W: Resident
+# Evil 4 1% low +32-38 % with the average about flat against boost off, where uncapped boost cost
+# 12.9 %. Fixed, those caps sit on the critical path of a CPU-bound game (Elden Ring ran slower), so
+# a core that saturates at its cap raises the level, and the level drops again only when every core
+# would stay well below saturation at the lower caps. kHz per core type; None = the core's maximum.
+SMART_BOOST_LEVELS_KHZ = (
+    (3000000, 2000000, 1500000),  # GPU-bound or frame-capped: the power goes to the GPU
+    (3800000, 2800000, 1500000),  # a P- or E-core saturated at level 0
+    (None, None, None),  # still saturated: no caps, as with boost Enabled
+)
+SMART_BOOST_CAPS_KHZ = SMART_BOOST_LEVELS_KHZ[0]
+SMART_UP_BUSY = 85.0  # % busy at the current cap: that core is the bottleneck
+SMART_DOWN_BUSY = 70.0  # % busy predicted at the lower cap: comfortably below saturation
+# The busiest thread needs more room than a core: a frame-capped game's main thread averages well
+# below saturation but its heavy frames do not, so a step down that leaves it near 50-60 % busy
+# makes those frames late (Elden Ring at 40-49 % stepped down to 3.0 GHz every lull). Below 45 %
+# at the lower cap a spike can still double without saturating the core.
+SMART_DOWN_THREAD_BUSY = 45.0
+SMART_DOWN_CHECKS = 3  # consecutive checks (hhd polls every 2 s) before stepping down
+SMART_CHECK_S = 2.0
+# Only the P- and E-cores decide: games run there, and background work on the LP E-cores (Steam's
+# shader pre-compilation) must not lift the caps.
+SMART_DECIDING_CLASSES = 2
+# The busiest thread decides as well as the busiest core: the scheduler moves a saturated thread
+# between cores, so its load is spread out and no core reaches SMART_UP_BUSY (Elden Ring's main
+# thread at 95 % of a core across cpu0/1/4 left every core below 70 %, and the P-cores at 3.8 GHz).
+# Only processes above SMART_HOT_PROC % of a core have their threads read, to keep the scan cheap.
+SMART_HOT_PROC = 50.0
 
 EPP_MODES = ("performance", "balance_performance", "balance_power", "power")
 EppStatus = Literal["performance", "balance_performance", "balance_power", "power"]
@@ -328,6 +361,228 @@ def set_cpu_boost(enable: bool):
         set_per_cpu(BOOST_FN, "1" if enable else "0")
 
 
+def get_cpu_classes() -> list[list[int]]:
+    """Online CPUs grouped by base frequency, fastest group first; [] when unknown."""
+    groups: dict[int, list[int]] = {}
+    try:
+        for dir in os.listdir(CPU_PATH):
+            if not dir.startswith(CPU_PREFIX):
+                continue
+            try:
+                num = int(dir[len(CPU_PREFIX) :])
+            except ValueError:
+                continue
+            fn = os.path.join(CPU_PATH, dir, CPU_BASE_FREQ_FN)
+            if not os.path.exists(fn):
+                continue  # offline CPUs have no cpufreq directory
+            with open(fn, "r") as f:
+                groups.setdefault(int(f.read().strip()), []).append(num)
+    except Exception as e:
+        logger.warning(f"Could not read the CPU core types:\n{e}")
+        return []
+    return [sorted(groups[b]) for b in sorted(groups, reverse=True)]
+
+
+def supports_smart_boost() -> bool:
+    """Smart boost needs Intel's three core types (P, E and LP E-cores)."""
+    return os.path.exists(INTEL_BOOST_PATH) and len(get_cpu_classes()) == len(
+        SMART_BOOST_CAPS_KHZ
+    )
+
+
+def smart_cap_khz(level: int, cls: int, top_khz: int) -> int:
+    cap = SMART_BOOST_LEVELS_KHZ[level][cls]
+    return top_khz if cap is None else min(cap, top_khz)
+
+
+def read_cpu_max_khz(num: int) -> int:
+    with open(os.path.join(CPU_PATH, CPU_PREFIX + str(num), CPU_FREQ_DRIVER_MAX_FN), "r") as f:
+        return int(f.read().strip())
+
+
+def set_smart_boost_caps(level: int = 0):
+    """Caps each core type at the clocks of a Smart level (never above what the core supports).
+    Call after set_frequency_scaling(), which resets every core's maximum."""
+    parts = []
+    for cls, cpus in enumerate(get_cpu_classes()[: len(SMART_BOOST_CAPS_KHZ)]):
+        khz = 0
+        for num in cpus:
+            khz = smart_cap_khz(level, cls, read_cpu_max_khz(num))
+            with open(os.path.join(CPU_PATH, CPU_PREFIX + str(num), CPU_FREQ_MAX_FN), "w") as f:
+                f.write(str(khz))
+        parts.append(f"cpu{cpus[0]}-{cpus[-1]} {khz / 1e6:.1f} GHz")
+    logger.info(f"Smart CPU boost level {level}: {', '.join(parts)}.")
+
+
+def read_cpu_times(stat: str = "/proc/stat") -> dict[int, tuple[int, int]]:
+    """cpu number -> (total, idle) jiffies."""
+    out = {}
+    with open(stat, "r") as f:
+        for line in f:
+            if line.startswith("cpu") and line[3:4].isdigit():
+                fields = line.split()
+                vals = [int(v) for v in fields[1:]]
+                out[int(fields[0][3:])] = (sum(vals), vals[3] + vals[4])
+    return out
+
+
+def _stat_ticks(path: str) -> int | None:
+    """utime + stime of a /proc stat file (the name in parentheses may contain spaces)."""
+    try:
+        with open(path, "r") as f:
+            s = f.read()
+    except OSError:
+        return None
+    fields = s[s.rfind(")") + 2 :].split()
+    try:
+        return int(fields[11]) + int(fields[12])
+    except (IndexError, ValueError):
+        return None
+
+
+def read_process_ticks(proc: str = "/proc") -> dict[int, int]:
+    out = {}
+    for e in os.listdir(proc):
+        if e.isdigit():
+            t = _stat_ticks(os.path.join(proc, e, "stat"))
+            if t is not None:
+                out[int(e)] = t
+    return out
+
+
+def read_thread_ticks(pid: int, proc: str = "/proc") -> dict[int, int]:
+    out = {}
+    try:
+        tids = os.listdir(os.path.join(proc, str(pid), "task"))
+    except OSError:
+        return out
+    for tid in tids:
+        if tid.isdigit():
+            t = _stat_ticks(os.path.join(proc, str(pid), "task", tid, "stat"))
+            if t is not None:
+                out[int(tid)] = t
+    return out
+
+
+def smart_next_level(
+    level: int,
+    busy: dict[int, float],
+    classes: list[list[int]],
+    tops: dict[int, int],
+    down_streak: int,
+    hot_thread: float = 0.0,
+) -> tuple[int, int]:
+    """The Smart level after one check: (level, down_streak). busy is % per cpu over the last
+    interval, measured at the current level's caps; tops the cores' maximum clock (kHz);
+    hot_thread the busiest thread's % of one core over the same interval."""
+    deciding = [
+        (cls, num)
+        for cls, cpus in enumerate(classes[:SMART_DECIDING_CLASSES])
+        for num in cpus
+        if num in busy
+    ]
+    if not deciding:
+        return level, 0
+    last = len(SMART_BOOST_LEVELS_KHZ) - 1
+    hottest = max(max(busy[num] for _, num in deciding), hot_thread)
+    if level < last and hottest >= SMART_UP_BUSY:
+        return level + 1, 0
+    if level == 0:
+        return 0, 0
+    # what each core would be busy at the lower caps: the same work at a lower clock
+    ratio = {
+        num: smart_cap_khz(level, cls, tops[num]) / smart_cap_khz(level - 1, cls, tops[num])
+        for cls, num in deciding
+    }
+    predicted = max(busy[num] * ratio[num] for _, num in deciding)
+    # the busiest thread may run on any of them: assume the largest slowdown, and keep it the
+    # extra headroom a frame-capped main thread needs (SMART_DOWN_THREAD_BUSY)
+    thread_predicted = hot_thread * max(ratio.values())
+    if predicted < SMART_DOWN_BUSY and thread_predicted < SMART_DOWN_THREAD_BUSY:
+        down_streak += 1
+        if down_streak >= SMART_DOWN_CHECKS:
+            return level - 1, 0
+        return level, down_streak
+    return level, 0
+
+
+class SmartBoost:
+    """Follows the load while CPU Boost is Smart: call tick() from the driver's update loop."""
+
+    def __init__(self):
+        self.level = 0
+        self.down_streak = 0
+        self.last = None  # (time, cpu times)
+        self.classes: list[list[int]] = []
+        self.tops: dict[int, int] = {}
+        self.hz = os.sysconf("SC_CLK_TCK")
+        self.proc_prev: dict[int, int] = {}
+        self.thread_prev: dict[tuple[int, int], int] = {}
+
+    def start(self, now: float):
+        self.classes = get_cpu_classes()
+        self.tops = {n: read_cpu_max_khz(n) for cpus in self.classes for n in cpus}
+        self.level, self.down_streak = 0, 0
+        self.last = (now, read_cpu_times())
+        self.proc_prev, self.thread_prev = read_process_ticks(), {}
+        set_smart_boost_caps(self.level)
+
+    def busiest_thread(self, dt: float) -> float:
+        """% of one core used by the busiest thread since the last check. Threads are read only for
+        processes above SMART_HOT_PROC; a process that just became hot counts from the next check."""
+        procs = read_process_ticks()
+        scale = 100.0 / self.hz / dt
+        hot = [
+            pid
+            for pid, t in procs.items()
+            if pid in self.proc_prev and (t - self.proc_prev[pid]) * scale >= SMART_HOT_PROC
+        ]
+        best, threads = 0.0, {}
+        for pid in hot:
+            for tid, t in read_thread_ticks(pid).items():
+                threads[(pid, tid)] = t
+                prev = self.thread_prev.get((pid, tid))
+                if prev is not None:
+                    best = max(best, (t - prev) * scale)
+        self.proc_prev, self.thread_prev = procs, threads
+        return best
+
+    def reapply(self):
+        set_smart_boost_caps(self.level)
+
+    def tick(self, now: float):
+        if self.last is None:
+            self.start(now)
+            return
+        if now - self.last[0] < SMART_CHECK_S:
+            return
+        times = read_cpu_times()
+        prev = self.last[1]
+        busy = {}
+        for num, (total, idle) in times.items():
+            if num in prev and total > prev[num][0]:
+                d_total = total - prev[num][0]
+                busy[num] = 100.0 * (1 - (idle - prev[num][1]) / d_total)
+        dt = now - self.last[0]
+        self.last = (now, times)
+        hot_thread = self.busiest_thread(dt)
+        level, self.down_streak = smart_next_level(
+            self.level, busy, self.classes, self.tops, self.down_streak, hot_thread
+        )
+        if level != self.level:
+            hottest = max(busy, key=busy.get) if busy else -1
+            logger.info(
+                f"Smart CPU boost {'raised' if level > self.level else 'lowered'} to level {level}"
+                f" (busiest core cpu{hottest} {busy.get(hottest, 0):.0f} %,"
+                f" busiest thread {hot_thread:.0f} %)."
+            )
+            self.level = level
+            set_smart_boost_caps(level)
+
+    def stop(self):
+        self.last = None
+
+
 def set_epp_mode(mode: EppStatus):
     logger.info(f"Setting EPP mode to '{mode}'.")
     set_per_cpu(EPP_FN, mode)
-- 
