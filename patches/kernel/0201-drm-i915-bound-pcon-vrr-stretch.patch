From 67eb6f3452b0fb811d075feadc23e29785fc371a Mon Sep 17 00:00:00 2001
From: oxp3-fixes <oxp3-fixes@localhost>
Date: Sun, 22 Nov 2026 16:47:51 +0000
Subject: [PATCH] drm/i915/vrr: bound the VRR stretch on FreeSync PCONs

PTL hardware puts the MSA Vtotal in the stream header from the VMAX
register (confirmed by converter-side capture: 6750 announced during a
40-120 Hz stretch while the driver programmed 2250). The VMM6210
re-times its HDMI output whenever that field changes, so the full 3x
stretch desyncs it into duplicated rows or black. amdgpu avoids this
by announcing the fixed stream vtotal.

Keep the announced Vtotal within pcon_vrr_max_stretch_pct (default 5)
percent of the mode timing on a FreeSync PCON: the converter re-times
once per VRR enable/disable like any mode change and frame delivery
still varies inside the band. 100 restores the full range.
---
 drivers/gpu/drm/i915/display/intel_vrr.c | 29 ++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/drivers/gpu/drm/i915/display/intel_vrr.c b/drivers/gpu/drm/i915/display/intel_vrr.c
index 9c6da7163..0682c4002 100644
--- a/drivers/gpu/drm/i915/display/intel_vrr.c
+++ b/drivers/gpu/drm/i915/display/intel_vrr.c
@@ -39,6 +39,23 @@ static bool pcon_vrr = true;
 module_param(pcon_vrr, bool, 0644);
 MODULE_PARM_DESC(pcon_vrr, "Offer VRR on DP-to-HDMI 2.1 PCON outputs (default: true)");
 
+/*
+ * oxp3: PTL hardware puts the MSA Vtotal in the DP stream header from the VMAX
+ * register, not from the mode timing (confirmed by capture: the converter saw
+ * the full-stretch VMAX, 6750 lines, while the driver programmed 2250). The
+ * VMM6210 re-times its HDMI output whenever that header field changes, so a
+ * full 40-120 Hz stretch (3x) desyncs it: duplicated rows or black. amdgpu
+ * avoids this by keeping the MSA header at the fixed stream vtotal.
+ * Bound the VRR stretch instead: the announced Vtotal then stays within a
+ * small percentage of the real mode timing, the converter re-times once per
+ * VRR enable/disable like any mode change, and frame delivery still varies
+ * (real VRR) inside the band. Tunable at runtime; 100 restores the full range.
+ */
+static int pcon_vrr_max_stretch_pct = 5;
+module_param_named(pcon_vrr_max_stretch_pct, pcon_vrr_max_stretch_pct, int, 0644);
+MODULE_PARM_DESC(pcon_vrr_max_stretch_pct,
+		 "Cap on VRR stretch for FreeSync PCON outputs, % of vtotal (default 5, 100 = full range)");
+
 bool intel_vrr_is_capable(struct intel_connector *connector)
 {
 	struct intel_display *display = to_intel_display(connector);
@@ -369,6 +386,18 @@ int intel_vrr_compute_vmax(struct intel_connector *connector,
 		(adjusted_mode->crtc_htotal * info->monitor_range.min_vfreq);
 	vmax = max_t(int, vmax, adjusted_mode->crtc_vtotal);
 
+	/* oxp3: keep the MSA-announced Vtotal near the mode timing on a
+	 * FreeSync PCON; see pcon_vrr_max_stretch_pct above.
+	 */
+	if (intel_attached_dp(connector)->pcon_freesync_ver &&
+	    pcon_vrr_max_stretch_pct < 100) {
+		int vtotal = adjusted_mode->crtc_vtotal;
+		int cap = vtotal + DIV_ROUND_CLOSEST(vtotal *
+						    pcon_vrr_max_stretch_pct, 100);
+
+		vmax = min_t(int, vmax, max(cap, vtotal + 1));
+	}
+
 	return vmax;
 }
 
