From ab4176390d6f3a935139cd69035e66bccd398ecf Mon Sep 17 00:00:00 2001
From: oxp3-fixes <oxp3-fixes@localhost>
Date: Sun, 22 Nov 2026 18:08:10 +0000
Subject: [PATCH] drm/i915/dp: default pcon_vrr_force_420 on, log 4:2:0
 fallbacks loudly

The knob defaulted off and its fallback reason logged only at debug
level, so a missed echo or a failed 4:2:0 config were both invisible in
the capture. Default it on for the FreeSync PCON VRR path and print an
oxp3-vrr: line with the error code whenever the 4:2:0 config fails.
---
 drivers/gpu/drm/i915/display/intel_dp.c | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_dp.c b/drivers/gpu/drm/i915/display/intel_dp.c
index 46faee12e..79aec4570 100644
--- a/drivers/gpu/drm/i915/display/intel_dp.c
+++ b/drivers/gpu/drm/i915/display/intel_dp.c
@@ -3468,10 +3468,10 @@ intel_dp_compute_output_format(struct intel_encoder *encoder,
  *  - pcon_vrr_no_msa_ignore: do not set DP_MSA_TIMING_PAR_IGNORE_EN, whose
  *    "ignore MSA timing" semantics can desync the converter's DSC decoder.
  */
-bool intel_dp_pcon_vrr_force_420;
+bool intel_dp_pcon_vrr_force_420 = true;
 module_param_named(pcon_vrr_force_420, intel_dp_pcon_vrr_force_420, bool, 0644);
 MODULE_PARM_DESC(pcon_vrr_force_420,
-		 "Prefer YCbCr 4:2:0 over RGB for VRR on FreeSync PCONs (default: false)");
+		 "Prefer YCbCr 4:2:0 over RGB for VRR on FreeSync PCONs (default: true)");
 bool intel_dp_pcon_vrr_no_msa_ignore;
 module_param_named(pcon_vrr_no_msa_ignore, intel_dp_pcon_vrr_no_msa_ignore, bool, 0644);
 MODULE_PARM_DESC(pcon_vrr_no_msa_ignore,
@@ -3516,10 +3516,16 @@ intel_dp_compute_formats(struct intel_encoder *encoder,
 							     respect_downstream_limits,
 							     INTEL_OUTPUT_FORMAT_YCBCR420);
 
-			if (ret)
-				drm_dbg_kms(display->drm, "PCON VRR: 4:2:0 not possible, falling back to RGB\n");
-			else
+			if (ret) {
+				drm_info(display->drm,
+					 "[CONNECTOR:%d:%s] oxp3-vrr: 4:2:0 VRR config failed (%d), falling back to RGB\n",
+					 connector->base.base.id, connector->base.name, ret);
+			} else {
+				drm_info(display->drm,
+					 "[CONNECTOR:%d:%s] oxp3-vrr: VRR path using YCbCr 4:2:0\n",
+					 connector->base.base.id, connector->base.name);
 				return ret;
+			}
 		}
 
 		ret = intel_dp_compute_output_format(encoder, crtc_state, conn_state,
-- 
2.56.0

