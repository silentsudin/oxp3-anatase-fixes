 		return false;
 
 	if (intel_psr_needs_alpm_aux_less(intel_dp, crtc_state) &&
@@ -3134,11 +3150,8 @@ static void intel_dp_compute_as_sdp(struct intel_dp *intel_dp,
 
 	crtc_state->infoframes.enable |= intel_hdmi_infoframe_enable(DP_SDP_ADAPTIVE_SYNC);
 
-	/*
-	 * The PCON path uses the legacy header-only AS SDP v1.  The DP 2.1
-	 * v2 payload is not parsed by a DP-to-HDMI 2.1 protocol converter.
-	 */
-	if (intel_dp->as_sdp_v1_supported && !intel_dp->as_sdp_v2_supported) {
+	/* PCON: header-only v1 packet, see intel_dp_needs_as_sdp() */
+	if (drm_dp_is_branch(intel_dp->dpcd)) {
 		as_sdp->sdp_type = DP_SDP_ADAPTIVE_SYNC;
 		as_sdp->revision = 0x1;
 		as_sdp->length = 0;
@@ -3178,6 +3191,67 @@ static void intel_dp_compute_as_sdp(struct intel_dp *intel_dp,
 		as_sdp->coasting_vtotal = crtc_state->vrr.vmax;
 }
 
+
+/*
+ * FreeSync through the PCON, as amdgpu drives it (FREESYNC_TYPE_PCON_IN_WHITELIST):
+ * the AMD FreeSync SPD InfoFrame, packed as a DP 1.3 InfoFrame SDP, goes out
+ * next to the header-only AS SDP whenever the mode is in the VRR range. Its
+ * enable stays the same across a VRR switch (a fastset); its flags follow
+ * vrr.enable and intel_dp_set_infoframes() rewrites it on that fastset. The
+ * packet is kept out of infoframes.spd, so the switch stays a fastset; the
+ * readout can't unpack a DP-packed SPD and leaves infoframes.spd zero too.
+ */
+static void intel_dp_compute_pcon_freesync(struct intel_dp *intel_dp,
+					   struct intel_crtc_state *crtc_state)
+{
+	if (!intel_dp->pcon_freesync_ver || !intel_dp_is_vrr_pcon(intel_dp) ||
+	    !crtc_state->vrr.in_range)
+		return;
+
+	crtc_state->infoframes.enable |=
+		intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_SPD);
+}
+
+static void intel_dp_write_pcon_freesync(struct intel_encoder *encoder,
+					 const struct intel_crtc_state *crtc_state)
+{
+	struct intel_digital_port *dig_port = enc_to_dig_port(encoder);
+	struct intel_dp *intel_dp = enc_to_intel_dp(encoder);
+	const struct drm_display_info *info =
+		&intel_dp->attached_connector->base.display_info;
+	int vrefresh = drm_mode_vrefresh(&crtc_state->hw.adjusted_mode);
+	u8 ver = intel_dp->pcon_freesync_ver == 1 ? 1 : 2;
+	u8 sdp[VIDEO_DIP_DATA_SIZE] = {};
+	u8 max_hz, min_hz;
+
+	if ((crtc_state->infoframes.enable &
+	     intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_SPD)) == 0)
+		return;
+
+	max_hz = min_t(int, info->monitor_range.max_vfreq, vrefresh);
+	min_hz = min_t(int, info->monitor_range.min_vfreq, max_hz);
+
+	/* SDP header: InfoFrame SDP, 0x1d + 1 data bytes, SDP version 1.3 */
+	sdp[0] = 0x00;
+	sdp[1] = HDMI_INFOFRAME_TYPE_SPD;
+	sdp[2] = 0x1d;
+	sdp[3] = 0x13 << 2;
+	/* DB0 = InfoFrame version, DB1 = length, DB2.. = PB1.. (no checksum) */
+	sdp[4 + 0] = ver;
+	sdp[4 + 1] = ver == 1 ? 0x08 : 0x09;
+	sdp[4 + 2] = 0x1a;	/* AMD IEEE OUI 00-00-1a */
+	sdp[4 + 3] = 0x00;
+	sdp[4 + 4] = 0x00;
+	/* FreeSync supported | enabled, active while VRR is on */
+	sdp[4 + 7] = 0x03 | (crtc_state->vrr.enable ? 0x04 : 0);
+	/* range while active, otherwise the nominal rate */
+	sdp[4 + 8] = crtc_state->vrr.enable ? min_hz : max_hz;
+	sdp[4 + 9] = max_hz;
+
+	dig_port->write_infoframe(encoder, crtc_state, HDMI_INFOFRAME_TYPE_SPD,
+				  sdp, sizeof(sdp));
+}
+
 static void intel_dp_compute_vsc_sdp(struct intel_dp *intel_dp,
 				     struct intel_crtc_state *crtc_state,
 				     const struct drm_connector_state *conn_state)
@@ -3660,6 +3734,7 @@ intel_dp_compute_config(struct intel_atomic_state *state,
 	intel_vrr_compute_config(pipe_config, conn_state);
 	intel_psr_compute_config(intel_dp, pipe_config, conn_state);
 	intel_dp_compute_as_sdp(intel_dp, pipe_config);
+	intel_dp_compute_pcon_freesync(intel_dp, pipe_config);
 	intel_alpm_lobf_compute_config(intel_dp, pipe_config, conn_state);
 	intel_dp_drrs_compute_config(connector, pipe_config, link_bpp_x16);
 	intel_dp_compute_vsc_sdp(intel_dp, pipe_config, conn_state);
@@ -5422,6 +5497,7 @@ void intel_dp_set_infoframes(struct intel_encoder *encoder,
 
 	intel_write_dp_sdp(encoder, crtc_state, DP_SDP_VSC);
 	intel_write_dp_sdp(encoder, crtc_state, DP_SDP_ADAPTIVE_SYNC);
+	intel_dp_write_pcon_freesync(encoder, crtc_state);
 
 	intel_write_dp_sdp(encoder, crtc_state, HDMI_PACKET_TYPE_GAMUT_METADATA);
 }
@@ -5443,7 +5519,9 @@ int intel_dp_as_sdp_unpack(struct drm_dp_as_sdp *as_sdp,
 	if (sdp->sdp_header.HB1 != DP_SDP_ADAPTIVE_SYNC)
 		return -EINVAL;
 
-	if ((sdp->sdp_header.HB3 & 0x3F) != 9)
+	/* v2 carries a 9-byte payload; the PCON's v1 packet is header-only */
+	if ((sdp->sdp_header.HB3 & 0x3F) != 9 &&
+	    !(sdp->sdp_header.HB2 == 1 && (sdp->sdp_header.HB3 & 0x3F) == 0))
 		return -EINVAL;
 
 	as_sdp->sdp_type = sdp->sdp_header.HB1;
@@ -6221,6 +6299,131 @@ intel_dp_update_420(struct intel_dp *intel_dp)
 		    str_yes_no(intel_dp->dfp.ycbcr_444_to_420));
 }
 
+/* A DP-to-HDMI 2.1 PCON that does VRR from the Adaptive-Sync SDP. */
+bool intel_dp_is_vrr_pcon(const struct intel_dp *intel_dp)
+{
+	return drm_dp_is_branch(intel_dp->dpcd) && intel_dp->as_sdp_v1_supported;
+}
+
+/*
+ * A VRR PCON gets MSA timing ignore only once the video stream is running,
+ * the way amdgpu programs it (enable_stream_features() after unblanking the
+ * stream; its link training leaves the bit clear). Written during link
+ * training instead, as i915 does for a native sink, the Synaptics VMM6210
+ * reads the bit back clear with the stream up, keeps following the MSA's
+ * fixed vtotal, and loses the HDMI picture on the first stretched frame.
+ */
+void intel_dp_pcon_enable_msa_timing_par_ignore(struct intel_dp *intel_dp,
+					       const struct intel_crtc_state *crtc_state)
+{
+	struct intel_display *display = to_intel_display(intel_dp);
+	u8 val;
+
+	if (!intel_dp_is_vrr_pcon(intel_dp) || !crtc_state->vrr.in_range)
+		return;
+
+	if (drm_dp_dpcd_readb(&intel_dp->aux, DP_DOWNSPREAD_CTRL, &val) != 1)
+		return;
+
+	if (val & DP_MSA_TIMING_PAR_IGNORE_EN)
+		return;
+
+	if (drm_dp_dpcd_writeb(&intel_dp->aux, DP_DOWNSPREAD_CTRL,
+			       val | DP_MSA_TIMING_PAR_IGNORE_EN) != 1)
+		drm_dbg_kms(display->drm, "PCON: failed to set MSA_TIMING_PAR_IGNORE\n");
+}
+
+/* DP branch OUIs amdgpu drives FreeSync through (dm_freesync_pcon_whitelist) */
+static const u32 intel_dp_freesync_pcon_ouis[] = {
+	0x0060ad, 0x00e04c, 0x90cc24, 0x001cf8, 0x001ff2, 0x2b02f0,
+};
+
+/*
+ * FreeSync PCON detection, as amdgpu's dm_get_adaptive_sync_support_type():
+ * an allow-listed DP-to-HDMI PCON that can ignore the MSA timing parameters,
+ * and an HDMI sink whose EDID has an AMD FreeSync VSDB (v1/v2; the EDID core
+ * only parses v3). The VRR range then comes from that VSDB, as on amdgpu.
+ */
+static void intel_dp_pcon_update_freesync(struct intel_dp *intel_dp,
+					  const struct drm_edid *drm_edid)
+{
+	struct intel_display *display = to_intel_display(intel_dp);
+	struct intel_connector *connector = intel_dp->attached_connector;
+	struct drm_display_info *info = &connector->base.display_info;
+	const struct edid *edid = drm_edid_raw(drm_edid);
+	const u8 *oui = intel_dp->desc.ident.oui;
+	u32 branch_oui = oui[0] << 16 | oui[1] << 8 | oui[2];
+	int ext, i;
+
+	intel_dp->pcon_freesync_ver = 0;
+
+	if (!edid || !intel_dp_is_vrr_pcon(intel_dp) || !info->is_hdmi ||
+	    !drm_dp_sink_can_do_video_without_timing_msa(intel_dp->dpcd))
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(intel_dp_freesync_pcon_ouis); i++)
+		if (intel_dp_freesync_pcon_ouis[i] == branch_oui)
+			break;
+	if (i == ARRAY_SIZE(intel_dp_freesync_pcon_ouis))
+		return;
+
+	for (ext = 1; ext <= edid->extensions; ext++) {
+		const u8 *blk = (const u8 *)edid + ext * EDID_LENGTH;
+		int end = blk[2];
+
+		/* CTA-861 extension, data blocks in [4, end) */
+		if (blk[0] != 0x02 || end < 4 || end > EDID_LENGTH - 1)
+			continue;
+
+		for (i = 4; i < end; i += 1 + (blk[i] & 0x1f)) {
+			int len = blk[i] & 0x1f;
+			const u8 *p = &blk[i + 1];
+
+			if (i + 1 + len > end)
+				break;
+			/* vendor-specific block, AMD OUI, version, caps, min, max */
+			if (blk[i] >> 5 != 3 || len < 7 ||
+			    p[0] != 0x1a || p[1] != 0x00 || p[2] != 0x00)
+				continue;
+			if (p[3] < 1 || p[3] > 2 || !(p[4] & 0x01) ||
+			    !p[5] || p[6] <= p[5] + 10)
+				continue;
+
+			intel_dp->pcon_freesync_ver = p[3];
+			info->monitor_range.min_vfreq = p[5];
+			info->monitor_range.max_vfreq = p[6];
+			drm_info(display->drm,
+				 "[CONNECTOR:%d:%s] oxp3-vrr: FreeSync PCON %06x, AMD VSDB v%u, range %u-%u Hz\n",
+				 connector->base.base.id, connector->base.name,
+				 branch_oui, p[3], p[5], p[6]);
+			return;
+		}
+	}
+}
+
+/*
+ * An HDMI 2.1 sink behind a PCON gives its VRR range in the HDMI Forum VSDB
+ * (display_info.hdmi.vrr_cap). display_info.monitor_range, which the VRR code
+ * uses, is only filled from an EDID 1.4 range descriptor, which TVs often lack
+ * (EDID 1.3), so take the range from the VSDB, as amdgpu does for HDMI sinks.
+ */
+static void intel_dp_pcon_update_vrr_range(struct intel_dp *intel_dp)
+{
+	struct drm_display_info *info =
+		&intel_dp->attached_connector->base.display_info;
+	const struct drm_hdmi_vrr_cap *vrr = &info->hdmi.vrr_cap;
+
+	if (!drm_dp_is_branch(intel_dp->dpcd) || !info->is_hdmi ||
+	    (info->monitor_range.min_vfreq && info->monitor_range.max_vfreq))
+		return;
+
+	if (!vrr->supported || !vrr->vrr_min || !vrr->vrr_max)
+		return;
+
+	info->monitor_range.min_vfreq = vrr->vrr_min;
+	info->monitor_range.max_vfreq = vrr->vrr_max;
+}
+
 static void
 intel_dp_set_edid(struct intel_dp *intel_dp)
 {
@@ -6235,6 +6438,8 @@ intel_dp_set_edid(struct intel_dp *intel_dp)
 
 	/* Below we depend on display info having been updated */
 	drm_edid_connector_update(&connector->base, drm_edid);
+	intel_dp_pcon_update_freesync(intel_dp, drm_edid);
+	intel_dp_pcon_update_vrr_range(intel_dp);
 
 	vrr_capable = intel_vrr_is_capable(connector);
 	drm_dbg_kms(display->drm, "[CONNECTOR:%d:%s] VRR capable: %s\n",
@@ -6263,6 +6468,7 @@ intel_dp_unset_edid(struct intel_dp *intel_dp)
 	intel_dp->dfp.max_tmds_clock = 0;
 
 	intel_dp->dfp.pcon_max_frl_bw = 0;
+	intel_dp->pcon_freesync_ver = 0;
 
 	intel_dp->dfp.ycbcr_444_to_420 = false;
 	connector->base.ycbcr_420_allowed = false;
@@ -6316,25 +6522,31 @@ intel_dp_detect_sdp_caps(struct intel_dp *intel_dp)
 {
 	struct intel_display *display = to_intel_display(intel_dp);
 
+	/* Detect afresh, so a PCON's state never carries over to the next sink. */
+	intel_dp->as_sdp_v1_supported = false;
+	intel_dp->as_sdp_v2_supported = false;
+
 	intel_dp->as_sdp_supported = HAS_AS_SDP(display) &&
 		drm_dp_as_sdp_supported(&intel_dp->aux, intel_dp->dpcd);
 
 	if (!intel_dp->as_sdp_supported)
 		return;
 
+	/*
+	 * A DP-to-HDMI 2.1 PCON that accepts the Adaptive-Sync SDP converts the
+	 * variable DP timing to HDMI VRR itself; it takes the header-only v1
+	 * packet (as amdgpu sends it).
+	 */
+	if (drm_dp_is_branch(intel_dp->dpcd)) {
+		intel_dp->as_sdp_v1_supported = true;
+		return;
+	}
+
 	/* eDP Adaptive-Sync SDP always uses AS SDP v2 */
 	if (intel_dp_is_edp(intel_dp))
 		intel_dp->as_sdp_v2_supported =  true;
 	else
 		intel_dp->as_sdp_v2_supported = intel_dp_sink_supports_as_sdp_v2(intel_dp);
-
-	/*
-	 * A DP-to-HDMI 2.1 PCON forwards the legacy AS SDP v1 packet.  The
-	 * downstream HDMI sink still advertises its VRR range through the
-	 * HDMI Forum VSDB, which is parsed into display_info.monitor_range.
-	 */
-	if (drm_dp_is_branch(intel_dp->dpcd))
-		intel_dp->as_sdp_v1_supported = true;
 }
 
 static bool intel_dp_needs_dpcd_probe(struct intel_dp *intel_dp, bool force_on_external)
diff --git a/drivers/gpu/drm/i915/display/intel_dp.h b/drivers/gpu/drm/i915/display/intel_dp.h
index 04fae203b..df31f7c4b 100644
--- a/drivers/gpu/drm/i915/display/intel_dp.h
