+
+	if (!old_crtc_state->vrr.msa_hold)
+		return;
+
+	intel_de_rmw(display, TRANS_VRR_CTL(display, cpu_transcoder),
+		     VRR_CTL_DCB_ADJ_ENABLE, 0);
+	intel_vrr_write_dcb_limits(display, cpu_transcoder, 0, 0);
+}
