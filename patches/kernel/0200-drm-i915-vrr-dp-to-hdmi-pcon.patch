@@ -3103,11 +3114,16 @@ static void intel_dp_compute_vsc_colorimetry(const struct intel_crtc_state *crtc
 static bool intel_dp_needs_as_sdp(struct intel_dp *intel_dp,
 				  struct intel_crtc_state *crtc_state)
 {
-	if (!intel_dp->as_sdp_v2_supported && !intel_dp->as_sdp_v1_supported)
-		return false;
+	/*
+	 * PCON: send the header-only v1 packet whenever the mode is in the VRR
+	 * range, at fixed and at variable refresh alike (as amdgpu does). The
+	 * packet, and the guardband it needs, then stay the same when VRR is
+	 * switched, so the switch is a fastset on the trained link.
+	 */
+	if (drm_dp_is_branch(intel_dp->dpcd))
