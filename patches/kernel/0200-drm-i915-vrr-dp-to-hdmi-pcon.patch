+static void intel_vrr_write_dcb_limits(struct intel_display *display,
+				       enum transcoder cpu_transcoder,
+				       u32 vmax, u32 flipline)
+{
+	intel_de_write(display, TRANS_VRR_DCB_VMAX(cpu_transcoder), vmax);
+	intel_de_write(display, TRANS_VRR_DCB_VMAX_LIVE(cpu_transcoder), vmax);
+	intel_de_write(display, TRANS_VRR_DCB_FLIPLINE(cpu_transcoder), flipline);
+	intel_de_write(display, TRANS_VRR_DCB_FLIPLINE_LIVE(cpu_transcoder), flipline);
+	intel_de_write(display, TRANS_VRR_DCB_ADJ_VMAX_CFG(cpu_transcoder), vmax);
+	intel_de_write(display, TRANS_VRR_DCB_ADJ_VMAX_CFG_LIVE(cpu_transcoder), vmax);
+	intel_de_write(display, TRANS_VRR_DCB_ADJ_FLIPLINE_CFG(cpu_transcoder), flipline);
+	intel_de_write(display, TRANS_VRR_DCB_ADJ_FLIPLINE_CFG_LIVE(cpu_transcoder), flipline);
+}
+
+/* See the vrr.msa_hold comment in intel_vrr_compute_config(). */
+static void intel_vrr_enable_msa_hold(const struct intel_crtc_state *crtc_state)
+{
+	struct intel_display *display = to_intel_display(crtc_state);
+	enum transcoder cpu_transcoder = crtc_state->cpu_transcoder;
+	int vmax = intel_vrr_hw_vmax(crtc_state) - 1;
+	int flipline = intel_vrr_hw_flipline(crtc_state) - 1;
+	int vtotal = intel_vrr_fixed_rr_hw_vmax(crtc_state);
+
+	if (!crtc_state->vrr.msa_hold)
+		return;
+
+	/* timing generator limits first, then switch it to them */
+	intel_vrr_write_dcb_limits(display, cpu_transcoder,
+				   VRR_DCB_VMAX(vmax), VRR_DCB_FLIPLINE(flipline));
+	intel_de_rmw(display, TRANS_VRR_CTL(display, cpu_transcoder),
+		     0, VRR_CTL_DCB_ADJ_ENABLE);
+	/* announced (MSA) vtotal stays the mode's vtotal */
+	intel_de_write(display, TRANS_VRR_VMAX(display, cpu_transcoder), vtotal - 1);
+
+	drm_info(display->drm,
+		 "[CRTC:%d:%s] oxp3-vrr: PCON MSA hold: MSA vtotal %d, VRR %d-%d lines\n",
+		 crtc_state->uapi.crtc->base.id, crtc_state->uapi.crtc->name,
+		 vtotal, crtc_state->vrr.flipline, crtc_state->vrr.vmax);
+}
