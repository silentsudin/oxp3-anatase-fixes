 .../drm/i915/display/intel_dp_link_training.c |   4 +-
 drivers/gpu/drm/i915/display/intel_hdmi.c     |  10 +
 drivers/gpu/drm/i915/display/intel_vrr.c      | 116 +++++++-
 7 files changed, 361 insertions(+), 30 deletions(-)

