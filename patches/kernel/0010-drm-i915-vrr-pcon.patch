From ec4c2377b94da946125f7f33b84b8364a287caa5 Mon Sep 17 00:00:00 2001
From: oxp3-fixes <oxp3-fixes@localhost>
Date: Wed, 18 Nov 2026 21:01:12 +0000
Subject: [PATCH] drm/i915/vrr: fix PCON capability and fixed-RR AS SDP

Do not require display_info.is_hdmi for the PCON branch path; the DPCD
AS SDP v1 capability and EDID VRR range are the relevant signals.  Also
do not emit AS SDP v1 for a fixed refresh rate, which caused a pipe-config
readout mismatch.
---
 drivers/gpu/drm/i915/display/intel_dp.c  |  2 +-
 drivers/gpu/drm/i915/display/intel_vrr.c | 12 ++++++++++--
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_dp.c b/drivers/gpu/drm/i915/display/intel_dp.c
index 9ca7e7543..abfde1a7a 100644
--- a/drivers/gpu/drm/i915/display/intel_dp.c
+++ b/drivers/gpu/drm/i915/display/intel_dp.c
@@ -3107,7 +3107,7 @@ static bool intel_dp_needs_as_sdp(struct intel_dp *intel_dp,
 		return false;
 
 	if (drm_dp_is_branch(intel_dp->dpcd) &&
-	    !intel_dp->as_sdp_v1_supported)
+	    (!intel_dp->as_sdp_v1_supported || !crtc_state->vrr.enable))
 		return false;
 
 	if (intel_psr_needs_alpm_aux_less(intel_dp, crtc_state) &&
diff --git a/drivers/gpu/drm/i915/display/intel_vrr.c b/drivers/gpu/drm/i915/display/intel_vrr.c
index 87b3c8059..0d752fc22 100644
--- a/drivers/gpu/drm/i915/display/intel_vrr.c
+++ b/drivers/gpu/drm/i915/display/intel_vrr.c
@@ -58,6 +58,15 @@ bool intel_vrr_is_capable(struct intel_connector *connector)
 		if (connector->mst.dp)
 			return false;
 		intel_dp = intel_attached_dp(connector);
+		drm_info(display->drm,
+			 "oxp3-vrr: type=%d mst=%d branch=%d hdmi=%d as_sdp=%d v1=%d v2=%d range=%d-%d\n",
+			 connector->base.connector_type, connector->mst.dp,
+			 drm_dp_is_branch(intel_dp->dpcd),
+			 intel_dp_has_hdmi_sink(intel_dp),
+			 intel_dp->as_sdp_supported,
+			 intel_dp->as_sdp_v1_supported,
+			 intel_dp->as_sdp_v2_supported,
+			 info->monitor_range.min_vfreq, info->monitor_range.max_vfreq);
 		/*
 		 * A non-MST DP branch device (PCON) can expose an HDMI 2.1 sink.
 		 * Such a sink needs the Adaptive-Sync SDP v1 forwarding path; only
@@ -65,8 +74,7 @@ bool intel_vrr_is_capable(struct intel_connector *connector)
 		 * an HDMI sink.
 		 */
 		if (drm_dp_is_branch(intel_dp->dpcd)) {
-			if (!intel_dp->as_sdp_v1_supported ||
-			    !intel_dp_has_hdmi_sink(intel_dp))
+			if (!intel_dp->as_sdp_v1_supported)
 				return false;
 		} else if (!drm_dp_sink_can_do_video_without_timing_msa(intel_dp->dpcd)) {
 			return false;
-- 
