From ef5aaf17ffaa6ea2dd6c61811f0db5370c5dbb7d Mon Sep 17 00:00:00 2001
From: oxp3-fixes <oxp3-fixes@localhost>
Date: Sun, 22 Nov 2026 17:45:01 +0000
Subject: [PATCH] drm/i915/dp: add force-420 and no-MSA-ignore knobs for the
 VMM6210 4K VRR failure

The desktop 4K120 link (no VRR) runs YCbCr 4:2:0 and is stable; the
VRR-enabled link runs RGB and goes black at 4K at every stretch width
(2%, 1%, 0%), while 1080p without DSC works. Add two runtime knobs to
isolate the two source-side differences:
 - pcon_vrr_force_420: prefer YCbCr 4:2:0 first in the VRR path,
   matching the stable desktop link;
 - pcon_vrr_no_msa_ignore: skip DP_MSA_TIMING_PAR_IGNORE_EN, whose
   ignore-MSA semantics can desync the converter's DSC decoder at 4K.
---
 drivers/gpu/drm/i915/display/intel_dp.c | 42 +++++++++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/drivers/gpu/drm/i915/display/intel_dp.c b/drivers/gpu/drm/i915/display/intel_dp.c
index 7b701569c..0ec86c0d9 100644
--- a/drivers/gpu/drm/i915/display/intel_dp.c
+++ b/drivers/gpu/drm/i915/display/intel_dp.c
@@ -3447,6 +3447,25 @@ intel_dp_compute_output_format(struct intel_encoder *encoder,
 					    respect_downstream_limits);
 }
 
+/*
+ * oxp3: knobs for the 4K VRR failure on the Synaptics VMM6210. The desktop
+ * 4K120 link (no VRR) runs YCbCr 4:2:0 and is stable; the VRR-enabled link
+ * runs RGB and goes black at 4K at any stretch width, while 1080p (no DSC)
+ * works. Both knobs isolate the two source-side differences:
+ *  - pcon_vrr_force_420: try YCbCr 4:2:0 first for the VRR path, like the
+ *    stable desktop link, instead of RGB-first;
+ *  - pcon_vrr_no_msa_ignore: do not set DP_MSA_TIMING_PAR_IGNORE_EN, whose
+ *    "ignore MSA timing" semantics can desync the converter's DSC decoder.
+ */
+bool intel_dp_pcon_vrr_force_420;
+module_param_named(pcon_vrr_force_420, intel_dp_pcon_vrr_force_420, bool, 0644);
+MODULE_PARM_DESC(pcon_vrr_force_420,
+		 "Prefer YCbCr 4:2:0 over RGB for VRR on FreeSync PCONs (default: false)");
+bool intel_dp_pcon_vrr_no_msa_ignore;
+module_param_named(pcon_vrr_no_msa_ignore, intel_dp_pcon_vrr_no_msa_ignore, bool, 0644);
+MODULE_PARM_DESC(pcon_vrr_no_msa_ignore,
+		 "Do not set MSA timing ignore for VRR on FreeSync PCONs (default: false)");
+
 static int
 intel_dp_compute_formats(struct intel_encoder *encoder,
 			 struct intel_crtc_state *crtc_state,
@@ -3474,6 +3493,24 @@ intel_dp_compute_formats(struct intel_encoder *encoder,
 							     INTEL_OUTPUT_FORMAT_RGB);
 		}
 	} else {
+		/*
+		 * oxp3: for the FreeSync PCON's VRR path prefer YCbCr 4:2:0
+		 * first, matching the stable desktop link, and fall back to
+		 * RGB. RGB-first pulls in the DSC-on-RGB configuration that
+		 * goes black at 4K.
+		 */
+		if (intel_dp_pcon_vrr_force_420 &&
+		    intel_dp->pcon_freesync_ver && crtc_state->vrr.in_range) {
+			ret = intel_dp_compute_output_format(encoder, crtc_state, conn_state,
+							     respect_downstream_limits,
+							     INTEL_OUTPUT_FORMAT_YCBCR420);
+
+			if (ret)
+				drm_dbg_kms(display->drm, "PCON VRR: 4:2:0 not possible, falling back to RGB\n");
+			else
+				return ret;
+		}
+
 		ret = intel_dp_compute_output_format(encoder, crtc_state, conn_state,
 						     respect_downstream_limits,
 						     INTEL_OUTPUT_FORMAT_RGB);
@@ -6322,6 +6359,11 @@ void intel_dp_pcon_enable_msa_timing_par_ignore(struct intel_dp *intel_dp,
 	if (!intel_dp_is_vrr_pcon(intel_dp) || !crtc_state->vrr.in_range)
 		return;
 
+	if (intel_dp_pcon_vrr_no_msa_ignore) {
+		drm_dbg_kms(display->drm, "PCON: skipping MSA_TIMING_PAR_IGNORE\n");
+		return;
+	}
+
 	if (drm_dp_dpcd_readb(&intel_dp->aux, DP_DOWNSPREAD_CTRL, &val) != 1)
 		return;
 
-- 
2.56.0

