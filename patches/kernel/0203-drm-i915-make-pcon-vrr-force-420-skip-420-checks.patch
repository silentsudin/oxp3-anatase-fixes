From 3150fb53bb6fdf9f2c9afa78f85b9d7551565b0d Mon Sep 17 00:00:00 2001
From: oxp3-fixes <oxp3-fixes@localhost>
Date: Sun, 22 Nov 2026 17:58:01 +0000
Subject: [PATCH] drm/i915/dp: make pcon_vrr_force_420 skip the EDID 4:2:0
 checks

The knob's 4:2:0-first attempt never took effect in Gamemode: the
generated modes are not EDID-declared 4:2:0 modes, so
intel_dp_sink_format_valid rejected them and the path silently fell
back to RGB. Skip the validation when the knob is set - the VMM6210
passes 4:2:0 straight through and the stable desktop 4K120 link runs
it.
---
 drivers/gpu/drm/i915/display/intel_dp.c | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/i915/display/intel_dp.c b/drivers/gpu/drm/i915/display/intel_dp.c
index 0ec86c0d9..46faee12e 100644
--- a/drivers/gpu/drm/i915/display/intel_dp.c
+++ b/drivers/gpu/drm/i915/display/intel_dp.c
@@ -3425,6 +3425,8 @@ static bool intel_dp_has_audio(struct intel_encoder *encoder,
 		return intel_conn_state->force_audio == HDMI_AUDIO_ON;
 }
 
+extern bool intel_dp_pcon_vrr_force_420;
+
 static int
 intel_dp_compute_output_format(struct intel_encoder *encoder,
 			       struct intel_crtc_state *crtc_state,
@@ -3432,11 +3434,20 @@ intel_dp_compute_output_format(struct intel_encoder *encoder,
 			       bool respect_downstream_limits,
 			       enum intel_output_format sink_format)
 {
+	bool force_420 = intel_dp_pcon_vrr_force_420;
+
 	struct intel_dp *intel_dp = enc_to_intel_dp(encoder);
 	struct intel_connector *connector = intel_dp->attached_connector;
 	const struct drm_display_mode *adjusted_mode = &crtc_state->hw.adjusted_mode;
 
-	if (intel_dp_sink_format_valid(connector, adjusted_mode,
+	/*
+	 * oxp3: with pcon_vrr_force_420, skip the EDID 4:2:0 mode checks. The
+	 * VMM6210 passes 4:2:0 straight through and the stable desktop 4K120
+	 * link runs it; the generated Gamemode modes just aren't EDID-declared
+	 * 4:2:0 modes, which silently forced the VRR path back to RGB.
+	 */
+	if (!force_420 &&
+	    intel_dp_sink_format_valid(connector, adjusted_mode,
 				       sink_format) != MODE_OK)
 		return -EINVAL;
 
-- 
