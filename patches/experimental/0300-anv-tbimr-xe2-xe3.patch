From 214d61a2b4c4b6cfc6a9e1517e3bfed6fc9e1cf4 Mon Sep 17 00:00:00 2001
From: silentsudin <25103587+silentsudin@users.noreply.github.com>
Date: Thu, 26 Nov 2026 14:25:03 +0000
Subject: [PATCH] anv: enable TBIMR on Xe2/Xe3 (experiment, not shipped)

The Windows Xe3 D3D12 driver (igd12um64xe3.dll 101.9175) emits
3DSTATE_TBIMR_TILE_PASS_INFO (header 0x786e0002, DW3 0x2c: TileBoxCheck=1,
batch size field 5); ANV only computes TBIMR tiling on gfx 12.5.

- compute TBIMR tiling on GFX_VERx10 >= 125 instead of == 125;
- Xe2+ has no L3 partition table (empty_l3_list), so device->l3_config is
  NULL and the tile cache size cannot come from it: target a fixed size,
  ANV_TBIMR_TC_KB (default 4096) - without this the first draw crashes;
- ANV_TBIMR_BATCH overrides the batch size field (Windows uses 5).

Toggle with the existing driconf option intel_tbimr (env intel_tbimr=false).
GravityMark 1.89 native Vulkan 1280x720 raster, Arc B390, 2026-11-26:
off 277.6/278.3/278.4, on 278.2/278.5, batch 5 278.1, 1 MB 278.2: neutral.
Not shipped: needs a bandwidth-heavy game A/B and a CTS pass first, and
the Xe3 CHICKEN_RASTER_2 bits differ from gfx 12.5 (bit 5 is now
"Disable Any MCTR response fix"), so the 12.5 init programming is not
copied.
---
 src/intel/common/intel_tiled_render.h | 12 ++++++++++++
 src/intel/vulkan/genX_gfx_state.c     | 20 +++++++++++++++-----
 2 files changed, 27 insertions(+), 5 deletions(-)

diff --git a/src/intel/common/intel_tiled_render.h b/src/intel/common/intel_tiled_render.h
index a22621f..8f653cf 100644
--- a/src/intel/common/intel_tiled_render.h
+++ b/src/intel/common/intel_tiled_render.h
@@ -26,6 +26,7 @@
 #include "intel/common/intel_l3_config.h"
 #include "intel/dev/intel_device_info.h"
 #include "intel/isl/isl.h"
+#include "util/u_debug.h"
 
 /**
  * Return the tile cache space used as target by the tiling parameter
@@ -37,6 +38,17 @@ UNUSED static unsigned
 intel_calculate_tile_cache_size(const struct intel_device_info *devinfo,
                                 const struct intel_l3_config *cfg)
 {
+   /* Xe2+ has no L3 partition table (empty_l3_list), so there is no config
+    * to size the tile cache from.  Experiment: target a fixed share of the
+    * cache, overridable with ANV_TBIMR_TC_KB.
+    */
+   if (cfg == NULL) {
+      static int tc_kb = -1;
+      if (tc_kb < 0)
+         tc_kb = debug_get_num_option("ANV_TBIMR_TC_KB", 4096);
+      return (unsigned)MAX2(tc_kb, 64) * 1024;
+   }
+
    const unsigned tc_l3_partition_size = 1024 * 8 *
       intel_get_l3_partition_size(devinfo, cfg, INTEL_L3P_TC);
    const unsigned all_l3_partition_size = 1024 * 8 *
diff --git a/src/intel/vulkan/genX_gfx_state.c b/src/intel/vulkan/genX_gfx_state.c
index 043f2df..84f17dc 100644
--- a/src/intel/vulkan/genX_gfx_state.c
+++ b/src/intel/vulkan/genX_gfx_state.c
@@ -609,7 +609,7 @@ is_src1_blend_factor(enum GENX(3D_Color_Buffer_Blend_Factor) factor)
           factor == BLENDFACTOR_INV_SRC1_ALPHA;
 }
 
-#if GFX_VERx10 == 125
+#if GFX_VERx10 >= 125
 /**
  * Return the dimensions of the current rendering area, defined as the
  * bounding box of all present color, depth and stencil attachments.
@@ -654,7 +654,10 @@ calculate_tile_dimensions(const struct anv_device *device,
                           unsigned fb_width, unsigned fb_height,
                           unsigned *tile_width, unsigned *tile_height)
 {
-   assert(GFX_VER == 12);
+   /* Xe2+ keeps CCS out of a separate aux surface, but the compressed
+    * footprint still lands in the tile cache, so the same ratio is a fair
+    * estimate there.
+    */
    const unsigned aux_scale = ISL_MAIN_TO_CCS_SIZE_RATIO_XE;
 
    unsigned pixel_size = 0;
@@ -2247,7 +2250,7 @@ update_scissors(struct anv_gfx_dynamic_state *hw_state,
    }
 }
 
-#if GFX_VERx10 == 125
+#if GFX_VERx10 >= 125
 ALWAYS_INLINE static void
 update_tbimr_info(struct anv_gfx_dynamic_state *hw_state,
                   const struct anv_device *device,
@@ -2273,8 +2276,15 @@ update_tbimr_info(struct anv_gfx_dynamic_state *hw_state,
           DIV_ROUND_UP(fb_height, tile_height));
       SET(TBIMR_TILE_PASS_INFO, tbimr.HorizontalTileCount,
           DIV_ROUND_UP(fb_width, tile_width));
+      /* Experiment only: ANV_TBIMR_BATCH overrides the batch size field
+       * (the Windows Xe3 D3D12 driver programs 5).
+       */
+      static int batch_override = -2;
+      if (batch_override == -2)
+         batch_override = debug_get_num_option("ANV_TBIMR_BATCH", -1);
       SET(TBIMR_TILE_PASS_INFO, tbimr.TBIMRBatchSize,
-          util_logbase2(batch_size) - 5);
+          batch_override >= 0 ? (unsigned)batch_override :
+                                util_logbase2(batch_size) - 5);
       SET(TBIMR_TILE_PASS_INFO, tbimr.TileBoxCheck, true);
       SET(TBIMR_TILE_PASS_INFO, use_tbimr, true);
    } else {
@@ -2633,7 +2643,7 @@ cmd_buffer_flush_gfx_runtime_state(struct anv_gfx_dynamic_state *hw_state,
        BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_VP_VIEWPORTS))
       update_scissors(hw_state, dyn, gfx, cmd_buffer_level);
 
-#if GFX_VERx10 == 125
+#if GFX_VERx10 >= 125
    if ((gfx->dirty & ANV_CMD_DIRTY_RENDER_TARGETS))
       update_tbimr_info(hw_state, device, gfx, device->l3_config);
 #endif
-- 
