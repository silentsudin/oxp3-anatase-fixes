[Unit]
Description=OneXPlayer 3: arm only the wake sources that should wake an s2idle suspend
Documentation=https://github.com/silentsudin/oxp3-anatase-fixes/blob/main/docs/hw/sleep-power.md
# Run once the ACPI/PCI/USB device tree is complete; the udev rule re-applies the USB and
# PCI parts after a re-enumeration (resume, dock hotplug), this covers the rest.
After=systemd-udev-settle.service local-fs.target
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/oxp3-sleep-wakeup
# Writes /proc/acpi/wakeup and /sys/.../power/wakeup, so it needs root and must not have
# ProtectKernelTunables= (that would make /sys read-only for it).
User=root
CapabilityBoundingSet=CAP_SYS_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot
# Environment knobs, see the script header:
#Environment=ALLOW_USB_WAKE=1
#Environment=ALLOW_AC_WAKE=1

[Install]
WantedBy=multi-user.target
