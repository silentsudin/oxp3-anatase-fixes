[Unit]
Description=Adaptive TDP for the OneXPlayer 3 (opt-in; moves between vendor presets on load/temp/battery)
Documentation=https://github.com/silentsudin/oxp3-anatase-fixes
# Deliberately NOT enabled by default: installing this unit does nothing until
# you run `sudo systemctl start oxp3-adaptivetdp`.  Enable only after the
# validation run in docs/hw/battery-tdp.md section 5.
ConditionPathExists=/sys/class/powercap/intel-rapl:0
# hhd and oxp3-tdp-sync also write the limits; start after them so the
# adaptive decision is the last writer, and stop the static profile unit from
# fighting it (oxp3-power-profile is oneshot at boot, so this is only ordering).
After=hhd.service oxp3-tdp-sync.service oxp3-power-profile.service
Wants=oxp3-tdp-sync.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/oxp3-adaptivetdp --interval 2 --min-interval 20 --log-file /var/log/oxp3-adaptivetdp.jsonl
# Exit on its own when the user stops it; restore the preset that was active
# when it started (the tool does that on SIGTERM unless --no-restore).
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=10
User=root
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
# powercap limits + the optional ACPI platform profile; the log trail lives in
# /var/log, which ProtectSystem=strict makes read-only otherwise.
ReadWritePaths=/sys/devices/virtual/powercap /sys/firmware/acpi /var/log
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
