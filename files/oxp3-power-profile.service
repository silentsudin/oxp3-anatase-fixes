[Unit]
Description=Apply the saved OneXPlayer 3 power profile (PL1/PL2/PL4) at boot
Documentation=https://github.com/silentsudin/oxp3-anatase-fixes
# The profile lives in /etc/oxp3/power.json, written once by
#   sudo oxp3-powerctl profile <quiet|balanced|performance> --save
ConditionPathExists=/etc/oxp3/power.json
ConditionPathExists=/sys/class/powercap/intel-rapl:0
# hhd writes its own TDP through the MMIO zone and oxp3-tdp-sync mirrors the
# MMIO PL1 into the MSR one; our write must come last so the saved profile
# wins at boot.
After=hhd.service oxp3-tdp-sync.service
Wants=hhd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/oxp3-powerctl restore
# Writes powercap sysfs, the oxpec hwmon and (optionally) platform_profile.
User=root
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ReadWritePaths=/sys/devices/virtual/powercap /sys/devices/platform/oxp-platform /sys/firmware/acpi
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
