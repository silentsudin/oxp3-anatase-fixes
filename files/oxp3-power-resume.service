[Unit]
Description=Re-apply the saved OneXPlayer 3 power profile after resume
Documentation=https://github.com/silentsudin/oxp3-anatase-fixes
# The EC and the firmware reset the RAPL package limits on resume; re-apply
# the same saved profile as oxp3-power-profile.service does at boot.
ConditionPathExists=/etc/oxp3/power.json
ConditionPathExists=/sys/class/powercap/intel-rapl:0
After=sleep.target
Wants=sleep.target

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/local/libexec/oxp3-powerctl restore
User=root
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ReadWritePaths=/sys/devices/virtual/powercap /sys/devices/platform/oxp-platform /sys/firmware/acpi
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=sleep.target
