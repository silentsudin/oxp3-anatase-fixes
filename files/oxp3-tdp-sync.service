[Unit]
Description=Keep the MSR package PL1 equal to the MMIO one set by hhd (OneXPlayer 3)
Documentation=https://github.com/silentsudin/oxp3-anatase-fixes
ConditionPathExists=/sys/class/powercap/intel-rapl:0
ConditionPathExists=/sys/class/powercap/intel-rapl-mmio:0

[Service]
ExecStart=/usr/local/libexec/oxp3-tdp-sync
Restart=on-failure
RestartSec=10
User=root
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/sys/devices/virtual/powercap
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
