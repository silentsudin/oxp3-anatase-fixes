[Unit]
Description=OXP3: restore the Gamemode HDR/PQ launcher flags before the session starts
After=local-fs.target
Before=display-manager.service
ConditionPathExists=/usr/local/libexec/oxp3-gamemode-hdr-keep

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/oxp3-gamemode-hdr-keep

[Install]
WantedBy=multi-user.target
