# never commit signing keys or build output
*.key
*.der
*.crt
*.pem
mok/
out/
vkd3d-proton.cache

# python bytecode from the tooling helpers
__pycache__/
*.pyc
*.pyo

# generic build output (the Decky plugin also has its own .gitignore)
dist/
build/
node_modules/
*.zip

# C test/build output of the fingerprint protocol library
tools/fingerprint/build/

# first-run evidence bundles: machine-local snapshots (journals, hashes), never committed
docs/state/firstrun-*/
docs/state/fp-session-*/
