+{
+  switch (name)
+    {
+    case BF63112_ACPI_SMALL_DMA:
+      return "dma";
+    case BF63112_ACPI_SMALL_START_DEPENDENT:
+      return "start-dependent";
+    case BF63112_ACPI_SMALL_END_DEPENDENT:
