+
+/* ------------------------------------------------------------ the walker */
+
+int
+bf63112_acpi_parse (const uint8_t *buf, size_t len,
+                    struct bf63112_acpi_template *out,
+                    enum bf63112_acpi_error *error)
+{
+  enum bf63112_acpi_error local_error = BF63112_ACPI_OK;
+  size_t offset = 0;
+
+  if (error == NULL)
+    error = &local_error;
+  *error = BF63112_ACPI_OK;
+  if (out == NULL || (buf == NULL && len > 0))
+    {
+      *error = BF63112_ACPI_ERR_INVALID;
+      return -1;
+    }
+  memset (out, 0, sizeof *out);
+  out->end_tag_offset = SIZE_MAX;
+  out->trailing_offset = len;
+
+  while (offset < len)
+    {
+      uint8_t tag = buf[offset];
+
+      if (tag == 0x79)   /* EndTag: small item 0x0F, length 1 (checksum) */
+        {
+          if (offset + 2 > len)
+            {
+              *error = BF63112_ACPI_ERR_TRUNCATED;
+              return -1;
+            }
+          out->has_end_tag = true;
+          out->end_tag_offset = offset;
+          offset += 2;
+          out->trailing_offset = offset;
+          out->trailing_length = len - offset;
+          return 0;
+        }
+      if (tag & 0x80)
+        {
+          uint8_t name = (uint8_t) (tag & 0x7Fu);
+          uint16_t length;
+          size_t total;
+
+          if (offset + 3 > len)
+            {
+              *error = BF63112_ACPI_ERR_TRUNCATED;
+              return -1;
+            }
+          if (u16_at (buf, len, offset + 1, &length, error) < 0)
+            return -1;
+          total = 3 + (size_t) length;
+          if (offset + total > len || offset + total < offset)
+            {
+              *error = BF63112_ACPI_ERR_TRUNCATED;
+              return -1;
+            }
+          if (name == BF63112_ACPI_LARGE_SERIAL_BUS)
+            {
+              if (decode_serial_bus (buf + offset + 3, length, total, offset,
+                                     out, error) < 0)
+                return -1;
+            }
+          else if (name == BF63112_ACPI_LARGE_GPIO)
+            {
+              if (decode_gpio (buf + offset + 3, length, total, offset, out,
+                               error) < 0)
+                return -1;
+            }
+          else if (name == BF63112_ACPI_LARGE_EXTENDED_IRQ)
+            {
+              if (decode_extended_irq (buf + offset + 3, length, total,
+                                       offset, out, error) < 0)
+                return -1;
+            }
+          else
+            {
+              struct bf63112_acpi_resource *resource;
+              const char *label = large_item_name (name);
+
+              resource = new_resource (out, BF63112_ACPI_KIND_OPAQUE, offset,
+                                       total, error);
+              if (resource == NULL)
+                return -1;
+              if (label != NULL)
+                set_opaque_name (resource, label);
+              else
+                snprintf (resource->name, sizeof resource->name,
+                          "large-0x%02x", name);
+            }
+          offset += total;
+          continue;
+        }
+
+      {
+        uint8_t name = (uint8_t) (tag >> 3);
+        size_t length = (size_t) (tag & 0x07u);
+        size_t total = 1 + length;
+
+        if (offset + total > len || offset + total < offset)
+          {
+            *error = BF63112_ACPI_ERR_TRUNCATED;
+            return -1;
+          }
+        if (name == BF63112_ACPI_SMALL_IRQ)
+          {
+            if (decode_small_irq (buf + offset + 1, length, total, offset,
+                                  out, error) < 0)
+              return -1;
+          }
+        else
+          {
+            struct bf63112_acpi_resource *resource;
+            const char *label = small_item_name (name);
+
+            resource = new_resource (out, BF63112_ACPI_KIND_OPAQUE, offset,
+                                     total, error);
+            if (resource == NULL)
+              return -1;
+            if (label != NULL)
+              set_opaque_name (resource, label);
+            else
+              snprintf (resource->name, sizeof resource->name,
+                        "small-0x%02x", name);
+          }
+        offset += total;
+      }
+    }
+  /* No EndTag is tolerated (some firmware omits it). */
+  out->trailing_offset = len;
+  out->trailing_length = 0;
+  return 0;
+}
+
+const char *
+bf63112_acpi_strerror (enum bf63112_acpi_error error)
+{
+  switch (error)
+    {
+    case BF63112_ACPI_OK:
+      return "ok";
+    case BF63112_ACPI_ERR_TRUNCATED:
+      return "truncated resource descriptor";
+    case BF63112_ACPI_ERR_BAD_SOURCE:
+      return "resource-source string outside the descriptor";
+    case BF63112_ACPI_ERR_BAD_PIN_TABLE:
+      return "GPIO pin table out of range or odd length";
+    case BF63112_ACPI_ERR_TOO_MANY:
+      return "too many resources, pins or IRQs";
+    case BF63112_ACPI_ERR_INVALID:
+      return "invalid argument";
+    default:
+      return "unknown ACPI parse error";
+    }
+}
+
+bool
+bf63112_acpi_is_spi (const struct bf63112_acpi_resource *resource)
+{
+  return resource != NULL &&
+         resource->kind == BF63112_ACPI_KIND_SERIAL_BUS &&
+         resource->has_serial_type &&
+         resource->serial_type == BF63112_ACPI_SERIAL_SPI;
+}
+
+int
+bf63112_acpi_spi_mode (const struct bf63112_acpi_resource *resource)
+{
+  if (resource == NULL || !resource->has_clock_phase ||
+      !resource->has_clock_polarity)
+    return -1;
+  return ((resource->clock_polarity & 1) << 1) |
+         (resource->clock_phase & 1);
+}
+
+const struct bf63112_acpi_resource *
+bf63112_acpi_first_spi (const struct bf63112_acpi_template *tmpl)
+{
+  size_t i;
+
+  if (tmpl == NULL)
+    return NULL;
+  for (i = 0; i < tmpl->n_resources; i++)
+    if (bf63112_acpi_is_spi (&tmpl->resources[i]))
+      return &tmpl->resources[i];
+  return NULL;
+}
+
+size_t
+bf63112_acpi_gpio_count (const struct bf63112_acpi_template *tmpl,
+                         int connection_type)
+{
+  size_t i, count = 0;
+
+  if (tmpl == NULL)
+    return 0;
+  for (i = 0; i < tmpl->n_resources; i++)
+    if (tmpl->resources[i].kind == BF63112_ACPI_KIND_GPIO &&
+        tmpl->resources[i].has_connection_type &&
+        tmpl->resources[i].connection_type == connection_type)
+      count++;
+  return count;
+}
+
+const struct bf63112_acpi_resource *
+bf63112_acpi_first_gpio (const struct bf63112_acpi_template *tmpl,
+                         int connection_type)
+{
+  size_t i;
+
+  if (tmpl == NULL)
+    return NULL;
+  for (i = 0; i < tmpl->n_resources; i++)
+    if (tmpl->resources[i].kind == BF63112_ACPI_KIND_GPIO &&
+        tmpl->resources[i].has_connection_type &&
+        tmpl->resources[i].connection_type == connection_type)
+      return &tmpl->resources[i];
+  return NULL;
+}
+
+void
+bf63112_acpi_spi_connection (const struct bf63112_acpi_template *tmpl,
+                             struct bf63112_acpi_spi_connection *connection)
+{
+  const struct bf63112_acpi_resource *spi;
+  const struct bf63112_acpi_resource *gpio_int;
+  const struct bf63112_acpi_resource *gpio_io;
+
+  if (connection == NULL)
+    return;
+  memset (connection, 0, sizeof *connection);
+  connection->irq_active_low = -1;
+  connection->irq_edge = 0;      /* rising is the documented default */
+  connection->has_irq_triggering = false;
+  connection->has_irq_polarity = false;
+  if (tmpl == NULL)
+    return;
+
+  spi = bf63112_acpi_first_spi (tmpl);
+  if (spi != NULL)
+    {
+      if (spi->has_resource_source)
+        {
+          memcpy (connection->controller, spi->resource_source,
+                  sizeof connection->controller);
+          connection->controller[sizeof connection->controller - 1] = '\0';
+          connection->has_controller = true;
+        }
+      if (spi->has_connection_speed_hz)
+        {
+          connection->speed_hz = spi->connection_speed_hz;
+          connection->has_speed_hz = true;
+        }
+      connection->mode = bf63112_acpi_spi_mode (spi);
+      connection->has_mode = connection->mode >= 0;
+      if (spi->has_data_bit_length)
+        {
+          connection->bits_per_word = spi->data_bit_length;
+          connection->has_bits_per_word = true;
+        }
+      if (spi->has_device_selection)
+        {
+          connection->chip_select = spi->device_selection;
+          connection->has_chip_select = true;
+        }
+    }
+
+  gpio_int = bf63112_acpi_first_gpio (tmpl, BF63112_ACPI_GPIO_TYPE_INT);
+  if (gpio_int != NULL)
+    {
+      if (gpio_int->n_pins > 0)
+        {
+          connection->irq_pin = (int) gpio_int->pins[0];
+          connection->has_irq_pin = true;
+        }
+      if (gpio_int->has_triggering)
+        {
+          connection->irq_triggering = gpio_int->triggering;
+          connection->has_irq_triggering = true;
+        }
+      if (gpio_int->has_polarity)
+        {
+          connection->irq_polarity = gpio_int->polarity;
+          connection->has_irq_polarity = true;
+        }
+      if (gpio_int->has_shareable)
+        {
+          connection->irq_shareable = gpio_int->shareable;
+          connection->has_irq_shareable = true;
+        }
+      if (gpio_int->has_polarity)
+        {
+          if (gpio_int->polarity == BF63112_ACPI_POLARITY_ACTIVE_LOW)
+            connection->irq_active_low = 1;
+          else if (gpio_int->polarity == BF63112_ACPI_POLARITY_ACTIVE_HIGH)
+            connection->irq_active_low = 0;
+        }
+      connection->irq_edge = 2;   /* level-triggered: request both edges */
+      if (gpio_int->has_triggering &&
+          gpio_int->triggering == BF63112_ACPI_TRIGGERING_EDGE)
+        {
+          connection->irq_edge =
+            (gpio_int->has_polarity &&
+             gpio_int->polarity == BF63112_ACPI_POLARITY_ACTIVE_BOTH)
+            ? 2 : 0;
+        }
+    }
+
+  gpio_io = bf63112_acpi_first_gpio (tmpl, BF63112_ACPI_GPIO_TYPE_IO);
+  if (gpio_io != NULL && gpio_io->n_pins > 0)
+    {
+      connection->reset_pin = (int) gpio_io->pins[0];
+      connection->has_reset_pin = true;
+    }
+}
diff --git a/libfprint/drivers/bf63112_acpi.h b/libfprint/drivers/bf63112_acpi.h
new file mode 100644
index 00000000..6d9a734b
--- /dev/null
+++ b/libfprint/drivers/bf63112_acpi.h
@@ -0,0 +1,270 @@
+/* TODO(licence): SPDX-License-Identifier to be set before submission;
+ * the project owner has not chosen the licence for this subtree yet. */
+/*
+ * bf63112_acpi.h - ACPI _CRS resource-template parser for the BF63112 SPI
+ *                  connection.
+ *
+ * The Windows driver never hard-codes the SPI clock, mode, word size, chip
+ * select or GPIOs: it takes them from the translated resources the firmware
+ * built from \_SB.PC00.SPI1.FPRT._CRS.  On Linux the same bytes live in the
+ * raw _CRS template (root-only on this host), so a driver/probe extracts the
+ * buffer once and feeds it here.  Only the descriptors this device needs are
+ * decoded (SpiSerialBus, GpioInt/GpioIo, small/extended IRQ); everything else
+ * is preserved as an opaque item with its offset so extra resources do not
+ * break the parse.
+ *
+ * Dependency-free (stdint/stddef only).  Every access is bounds-checked and a
+ * malformed or truncated template returns an error instead of crashing.
+ */
+
+#ifndef BF63112_ACPI_H
+#define BF63112_ACPI_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define BF63112_ACPI_MAX_RESOURCES 32
+#define BF63112_ACPI_MAX_PINS      16
+#define BF63112_ACPI_MAX_IRQS      16
+#define BF63112_ACPI_MAX_SOURCE    128
+
+/* Resource item names (ACPI 6.x resource type bytes). */
+#define BF63112_ACPI_SMALL_IRQ             0x04
+#define BF63112_ACPI_SMALL_DMA             0x05
+#define BF63112_ACPI_SMALL_START_DEPENDENT 0x06
+#define BF63112_ACPI_SMALL_END_DEPENDENT   0x07
+#define BF63112_ACPI_SMALL_IO              0x08
+#define BF63112_ACPI_SMALL_FIXED_IO        0x09
+#define BF63112_ACPI_SMALL_FIXED_DMA       0x0A
+#define BF63112_ACPI_SMALL_VENDOR          0x0E
+#define BF63112_ACPI_SMALL_END_TAG         0x0F
+
+#define BF63112_ACPI_LARGE_MEMORY24         0x01
+#define BF63112_ACPI_LARGE_GENERIC_REGISTER 0x02
+#define BF63112_ACPI_LARGE_VENDOR           0x03
+#define BF63112_ACPI_LARGE_MEMORY32         0x04
+#define BF63112_ACPI_LARGE_FIXED_MEMORY32   0x05
+#define BF63112_ACPI_LARGE_ADDRESS32        0x06
+#define BF63112_ACPI_LARGE_ADDRESS16        0x07
+#define BF63112_ACPI_LARGE_EXTENDED_IRQ     0x08
+#define BF63112_ACPI_LARGE_ADDRESS64        0x09
+#define BF63112_ACPI_LARGE_EXTENDED_ADDRESS64 0x0A
+#define BF63112_ACPI_LARGE_EXTENDED_SPACE   0x0B
+#define BF63112_ACPI_LARGE_GPIO             0x0C
+#define BF63112_ACPI_LARGE_PIN_FUNCTION     0x0D
+#define BF63112_ACPI_LARGE_SERIAL_BUS       0x0E
+#define BF63112_ACPI_LARGE_PIN_CONFIG       0x0F
+#define BF63112_ACPI_LARGE_PIN_GROUP        0x10
+#define BF63112_ACPI_LARGE_PIN_GROUP_FUNCTION 0x11
+#define BF63112_ACPI_LARGE_PIN_GROUP_CONFIG 0x12
+#define BF63112_ACPI_LARGE_CLOCK_INPUT      0x13
+
+#define BF63112_ACPI_SERIAL_I2C  1
+#define BF63112_ACPI_SERIAL_SPI  2
+#define BF63112_ACPI_SERIAL_UART 3
+#define BF63112_ACPI_SERIAL_CSI2 4
+
+#define BF63112_ACPI_SPI_FLAG_WIRE_MODE_3        (1u << 0)
+#define BF63112_ACPI_SPI_FLAG_DEVICE_POLARITY_HIGH (1u << 1)
+
+#define BF63112_ACPI_GPIO_TYPE_INT 0
+#define BF63112_ACPI_GPIO_TYPE_IO  1
+
+/* GPIO InterruptAndIoFlags bit fields (ACPI 6.x). */
+#define BF63112_ACPI_GPIO_TRIGGERING_MASK      0x1u
+#define BF63112_ACPI_GPIO_POLARITY_SHIFT       1
+#define BF63112_ACPI_GPIO_POLARITY_MASK        0x3u
+#define BF63112_ACPI_GPIO_SHAREABLE            (1u << 3)
+#define BF63112_ACPI_GPIO_WAKE_CAPABLE         (1u << 4)
+#define BF63112_ACPI_GPIO_IO_RESTRICTION_SHIFT 5
+#define BF63112_ACPI_GPIO_IO_RESTRICTION_MASK  (0x3u << 5)
+
+enum bf63112_acpi_kind
+{
+  BF63112_ACPI_KIND_OTHER = 0,
+  BF63112_ACPI_KIND_SERIAL_BUS,
+  BF63112_ACPI_KIND_GPIO,
+  BF63112_ACPI_KIND_IRQ,
+  BF63112_ACPI_KIND_EXTENDED_IRQ,
+  BF63112_ACPI_KIND_OPAQUE,
+};
+
+enum bf63112_acpi_triggering
+{
+  BF63112_ACPI_TRIGGERING_UNKNOWN = 0,
+  BF63112_ACPI_TRIGGERING_LEVEL,
+  BF63112_ACPI_TRIGGERING_EDGE,
+};
+
+enum bf63112_acpi_polarity
+{
+  BF63112_ACPI_POLARITY_UNKNOWN = 0,
+  BF63112_ACPI_POLARITY_ACTIVE_HIGH,
+  BF63112_ACPI_POLARITY_ACTIVE_LOW,
+  BF63112_ACPI_POLARITY_ACTIVE_BOTH,
+};
+
+enum bf63112_acpi_io_restriction
+{
+  BF63112_ACPI_IO_UNKNOWN = 0,
+  BF63112_ACPI_IO_NONE,
+  BF63112_ACPI_IO_INPUT,
+  BF63112_ACPI_IO_OUTPUT,
+  BF63112_ACPI_IO_NONE_PRESERVE,
+};
+
+enum bf63112_acpi_error
+{
+  BF63112_ACPI_OK = 0,
+  BF63112_ACPI_ERR_TRUNCATED,
+  BF63112_ACPI_ERR_BAD_SOURCE,
+  BF63112_ACPI_ERR_BAD_PIN_TABLE,
+  BF63112_ACPI_ERR_TOO_MANY,
+  BF63112_ACPI_ERR_INVALID,
+};
+
+struct bf63112_acpi_resource
+{
+  enum bf63112_acpi_kind kind;
+  char   name[24];               /*: "serial-bus", "gpio", "io", ... */
+  size_t offset;                 /*: byte offset in the template */
+  size_t length;                 /*: total item bytes incl. header */
+
+  /* Serial bus */
+  int    serial_type;
+  bool   has_serial_type;
+  int    revision;
+  bool   has_revision;
+  int    resource_source_index;
+  bool   has_resource_source_index;
+  char   resource_source[BF63112_ACPI_MAX_SOURCE];
+  bool   has_resource_source;
+  int    general_flags;
+  bool   has_general_flags;
+  int    type_specific_flags;
+  bool   has_type_specific_flags;
+  int    type_revision;
+  bool   has_type_revision;
+  int    type_data_length;
+  bool   has_type_data_length;
+  uint32_t connection_speed_hz;
+  bool   has_connection_speed_hz;
+  int    data_bit_length;
+  bool   has_data_bit_length;
+  int    clock_phase;
+  bool   has_clock_phase;
+  int    clock_polarity;
+  bool   has_clock_polarity;
+  int    device_selection;
+  bool   has_device_selection;
+  bool   wire_mode_three;
+  bool   device_polarity_high;
+
+  /* GPIO */
+  int    connection_type;
+  bool   has_connection_type;
+  uint16_t pins[BF63112_ACPI_MAX_PINS];
+  size_t n_pins;
+  enum bf63112_acpi_triggering triggering;
+  bool   has_triggering;
+  enum bf63112_acpi_polarity polarity;
+  bool   has_polarity;
+  bool   shareable;
+  bool   has_shareable;
+  bool   wake_capable;
+  bool   has_wake_capable;
+  enum bf63112_acpi_io_restriction io_restriction;
+  bool   has_io_restriction;
+  int    pin_config;
+  bool   has_pin_config;
+  int    drive_strength;
+  bool   has_drive_strength;
+  int    debounce_ms;
+  bool   has_debounce_ms;
+
+  /* IRQ */
+  uint32_t irqs[BF63112_ACPI_MAX_IRQS];
+  size_t n_irqs;
+  int    irq_flags;
+  bool   has_irq_flags;
+};
+
+struct bf63112_acpi_template
+{
+  struct bf63112_acpi_resource resources[BF63112_ACPI_MAX_RESOURCES];
+  size_t n_resources;
+  size_t end_tag_offset;         /*: SIZE_MAX when no EndTag was present */
+  bool   has_end_tag;
+  size_t trailing_offset;        /*: first byte after the EndTag */
+  size_t trailing_length;        /*: bytes after the EndTag, preserved */
+};
+
+/*! True when the resource is a SpiSerialBus descriptor. */
+bool bf63112_acpi_is_spi (const struct bf63112_acpi_resource *resource);
+
+/*! Linux SPI_MODE_*: (CPOL << 1) | CPHA, or -1 when the fields are absent. */
+int bf63112_acpi_spi_mode (const struct bf63112_acpi_resource *resource);
+
+/*! Decode one raw _CRS resource template.  Returns 0 or -1 + @error. */
+int bf63112_acpi_parse (const uint8_t *buf, size_t len,
+                        struct bf63112_acpi_template *out,
+                        enum bf63112_acpi_error *error);
+
+const char *bf63112_acpi_strerror (enum bf63112_acpi_error error);
+
+const struct bf63112_acpi_resource *
+bf63112_acpi_first_spi (const struct bf63112_acpi_template *tmpl);
+
+size_t bf63112_acpi_gpio_count (const struct bf63112_acpi_template *tmpl,
+                                int connection_type);
+
+const struct bf63112_acpi_resource *
+bf63112_acpi_first_gpio (const struct bf63112_acpi_template *tmpl,
+                         int connection_type);
+
+/*! Everything an SPI driver needs, reduced from one template. */
+struct bf63112_acpi_spi_connection
+{
+  char   controller[BF63112_ACPI_MAX_SOURCE];
+  bool   has_controller;
+  uint32_t speed_hz;
+  bool   has_speed_hz;
+  int    mode;
+  bool   has_mode;
+  int    bits_per_word;
+  bool   has_bits_per_word;
+  int    chip_select;
+  bool   has_chip_select;
+
+  int    irq_pin;
+  bool   has_irq_pin;
+  enum bf63112_acpi_triggering irq_triggering;
+  bool   has_irq_triggering;
+  enum bf63112_acpi_polarity irq_polarity;
+  bool   has_irq_polarity;
+  bool   irq_shareable;
+  bool   has_irq_shareable;
+
+  int    reset_pin;
+  bool   has_reset_pin;
+
+  /*! -1 unknown, 0 active high, 1 active low. */
+  int    irq_active_low;
+  /*! 0 rising, 1 falling, 2 both (the logical assertion edge). */
+  int    irq_edge;
+};
+
+void bf63112_acpi_spi_connection (
+  const struct bf63112_acpi_template *tmpl,
+  struct bf63112_acpi_spi_connection *connection);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* BF63112_ACPI_H */
diff --git a/libfprint/drivers/bf63112_discover.c b/libfprint/drivers/bf63112_discover.c
new file mode 100644
index 00000000..155e4755
--- /dev/null
+++ b/libfprint/drivers/bf63112_discover.c
@@ -0,0 +1,104 @@
+/* TODO(licence): SPDX-License-Identifier to be set before submission;
+ * the project owner has not chosen the licence for this subtree yet. */
+/*
+ * bf63112_discover.c - find the BF63112 spidev node by ACPI modalias.
+ *
+ * Sysfs-only, read-only, no /dev/spidev access.  See bf63112_discover.h.
+ */
+
+#include "bf63112_discover.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+#define BF63112_ACPI_MODALIAS "acpi:BF63112"
+
+static int
+modalias_matches (const char *path)
+{
+  char buf[128];
+  FILE *file;
+  size_t len;
+
+  file = fopen (path, "r");
+  if (file == NULL)
+    return 0;
+  if (fgets (buf, sizeof buf, file) == NULL)
+    {
+      fclose (file);
+      return 0;
+    }
+  fclose (file);
+  len = strlen (buf);
+  while (len > 0 && (buf[len - 1] == '\n' || buf[len - 1] == '\r'))
+    buf[--len] = '\0';
+  if (strncmp (buf, BF63112_ACPI_MODALIAS,
+               strlen (BF63112_ACPI_MODALIAS)) != 0)
+    return 0;
+  /* Linux emits "acpi:BF63112:"; accept the bare id too but not a longer
+   * id that merely starts with the same characters. */
+  return buf[strlen (BF63112_ACPI_MODALIAS)] == '\0' ||
+         buf[strlen (BF63112_ACPI_MODALIAS)] == ':';
+}
+
+static int
+scan_spidev_class (const char *sysfs_root, const char *dev_root,
+                   char *out, size_t out_size)
+{
+  char class_dir[512];
+  DIR *dir;
+  struct dirent *entry;
+  size_t matches = 0;
+  char found[256] = "";
+
+  if (snprintf (class_dir, sizeof class_dir, "%s/class/spidev", sysfs_root) >=
+      (int) sizeof class_dir)
+    return -ENAMETOOLONG;
+  dir = opendir (class_dir);
+  if (dir == NULL)
+    return errno == ENOENT ? -ENOENT : -errno;
+
+  while ((entry = readdir (dir)) != NULL)
+    {
+      char modalias[640];
+
+      if (strncmp (entry->d_name, "spidev", 6) != 0)
+        continue;
+      if (snprintf (modalias, sizeof modalias, "%s/%s/device/modalias",
+                    class_dir, entry->d_name) >= (int) sizeof modalias)
+        continue;
+      if (!modalias_matches (modalias))
+        continue;
+      matches++;
+      if (matches == 1)
+        snprintf (found, sizeof found, "%s", entry->d_name);
+    }
+  closedir (dir);
+
+  if (matches == 0)
+    return -ENOENT;
+  if (matches > 1)
+    return -ENOTUNIQ;
+  if (snprintf (out, out_size, "%s/%s", dev_root, found) >= (int) out_size)
+    return -ENAMETOOLONG;
+  return 0;
+}
+
+int
+bf63112_discover_spidev (const char *sysfs_root, const char *dev_root,
+                         const char *override, char *out, size_t out_size)
+{
+  if (dev_root == NULL || out == NULL || out_size == 0)
+    return -EINVAL;
+  if (override != NULL && *override != '\0')
+    {
+      if (snprintf (out, out_size, "%s", override) >= (int) out_size)
+        return -ENAMETOOLONG;
+      return 0;
+    }
+  if (sysfs_root == NULL || *sysfs_root == '\0')
+    sysfs_root = "/sys";
+  return scan_spidev_class (sysfs_root, dev_root, out, out_size);
+}
diff --git a/libfprint/drivers/bf63112_discover.h b/libfprint/drivers/bf63112_discover.h
new file mode 100644
index 00000000..2a8e2d7d
--- /dev/null
+++ b/libfprint/drivers/bf63112_discover.h
@@ -0,0 +1,44 @@
+/* TODO(licence): SPDX-License-Identifier to be set before submission;
+ * the project owner has not chosen the licence for this subtree yet. */
+/*
+ * bf63112_discover.h - resolve the BF63112 spidev node without udev data.
+ *
+ * libfprint usually hands a driver an spidev path through its udev data, but
+ * that depends on libfprint's 70-libfprint-2.rules binding spidev.  When the
+ * udev data is missing (or a bring-up build wants an explicit node), this
+ * helper finds the single SPI device whose modalias starts with
+ * "acpi:BF63112".  It reads sysfs only and never opens /dev/spidev.
+ */
+
+#ifndef BF63112_DISCOVER_H
+#define BF63112_DISCOVER_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*!
+ * Resolve a spidev path.
+ *
+ * @sysfs_root: sysfs mount point, normally "/sys".
+ * @dev_root:   devtmpfs mount point, normally "/dev".
+ * @override:   explicit path (e.g. from BF63112_SPIDEV); used verbatim when
+ *              non-NULL and non-empty.
+ * @out/@out_size: receives e.g. "/dev/spidev0.0".
+ *
+ * Returns 0 on success, -ENOENT when no device matches, -ENOTUNIQ when more
+ * than one does (refusing to guess), -ENAMETOOLONG or -EINVAL otherwise.
+ * A match is a /sys/class/spidev/spidevX.Y entry whose device/modalias is
+ * "acpi:BF63112" (a trailing ':' is accepted, as Linux emits it).
+ */
+int bf63112_discover_spidev (const char *sysfs_root, const char *dev_root,
+                             const char *override,
+                             char *out, size_t out_size);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* BF63112_DISCOVER_H */
diff --git a/libfprint/drivers/bf63112_proto.c b/libfprint/drivers/bf63112_proto.c
new file mode 100644
index 00000000..5a281a11
--- /dev/null
+++ b/libfprint/drivers/bf63112_proto.c
@@ -0,0 +1,409 @@
+/* TODO(licence): SPDX-License-Identifier to be set before submission;
+ * the project owner has not chosen the licence for this subtree yet. */
+/*
+ * bf63112_proto.c - dependency-free BF63112 frame protocol (see the header).
+ *
+ * The same frame rules are exercised by the userspace test harness used to
+ * recover the format; this file needs no GLib and no libfprint headers.
+ */
+
+#include "bf63112_proto.h"
+
+#include <string.h>
+
+/* ---- arithmetic --------------------------------------------------------- */
+
+size_t
+bf63112_align16 (size_t n)
+{
+  return (n + (BF63112_ALIGN - 1)) & ~(size_t) (BF63112_ALIGN - 1);
+}
+
+size_t
+bf63112_command_block_len (size_t data_len)
+{
+  return bf63112_align16 (BF63112_CMD_BLOCK_FIXED + data_len);
+}
+
+size_t
+bf63112_length_field (size_t data_len)
+{
+  return 4 + BF63112_HDR_RESERVED + bf63112_command_block_len (data_len);
+}
+
+size_t
+bf63112_frame_size (size_t data_len)
+{
+  return BF63112_FRAME_OVERHEAD + bf63112_length_field (data_len);
+}
+
+/* ---- checksums ---------------------------------------------------------- */
+
+uint32_t
+bf63112_crc32 (const uint8_t *data, size_t len)
+{
+  uint32_t crc = 0xFFFFFFFFu;
+  size_t i;
+  int bit;
+
+  for (i = 0; i < len; i++)
+    {
+      crc ^= data[i];
+      for (bit = 0; bit < 8; bit++)
+        crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u)));
+    }
+  return ~crc;
+}
+
+uint8_t
+bf63112_sum8 (const uint8_t *data, size_t len)
+{
+  uint32_t sum = 0;
+  size_t i;
+
+  for (i = 0; i < len; i++)
+    sum += data[i];
+  return (uint8_t) sum;
+}
+
+static uint32_t
+get_le32 (const uint8_t *p)
+{
+  return (uint32_t) p[0] | ((uint32_t) p[1] << 8) |
+         ((uint32_t) p[2] << 16) | ((uint32_t) p[3] << 24);
+}
+
+static uint16_t
+get_le16 (const uint8_t *p)
+{
+  return (uint16_t) (p[0] | (p[1] << 8));
+}
+
+static void
+put_le32 (uint8_t *p, uint32_t v)
+{
+  p[0] = (uint8_t) (v & 0xFF);
+  p[1] = (uint8_t) ((v >> 8) & 0xFF);
+  p[2] = (uint8_t) ((v >> 16) & 0xFF);
+  p[3] = (uint8_t) ((v >> 24) & 0xFF);
+}
+
+static void
+put_le16 (uint8_t *p, uint16_t v)
+{
+  p[0] = (uint8_t) (v & 0xFF);
+  p[1] = (uint8_t) ((v >> 8) & 0xFF);
+}
+
+/* ---- build -------------------------------------------------------------- */
+
+size_t
+bf63112_build_frame (uint8_t        opcode,
+                     uint8_t        phase,
+                     uint8_t        status,
+                     uint16_t       arg,
+                     const uint8_t *data,
+                     size_t         data_len,
+                     uint8_t       *out,
+                     size_t         out_size)
+{
+  size_t block, total, off;
+  uint32_t crc;
+
+  if (out == NULL || data_len > BF63112_MAX_DATA_LEN)
+    return 0;
+  if (data_len > 0 && data == NULL)
+    return 0;
+
+  block = bf63112_command_block_len (data_len);
+  total = bf63112_frame_size (data_len);
+  if (out_size < total)
+    return 0;
+
+  memset (out, 0, total);
+  off = 0;
+  out[off++] = BF63112_SOF;
+  put_le32 (out + off, (uint32_t) bf63112_length_field (data_len));
+  off += 4;
+  off += BF63112_HDR_RESERVED;          /* zeros: request header area */
+  out[off++] = BF63112_CMD_MAGIC;
+  out[off++] = opcode;
+  out[off++] = phase;
+  out[off++] = status;
+  put_le16 (out + off, arg);
+  off += 2;
+  put_le32 (out + off, (uint32_t) data_len);
+  off += 4;
+  if (data_len > 0)
+    memcpy (out + off, data, data_len);
+  /* the remainder of the aligned block stays zero */
+  off += data_len;
+  (void) off;
+  (void) block;
+
+  crc = bf63112_crc32 (out, total - 4);
+  put_le32 (out + total - 4, crc);
+  return total;
+}
+
+/* ---- parse -------------------------------------------------------------- */
+
+const char *
+bf63112_parse_result_str (enum bf63112_parse_result result)
+{
+  switch (result)
+    {
+    case BF63112_PARSE_OK:            return "ok";
+    case BF63112_PARSE_TRUNCATED:     return "truncated frame";
+    case BF63112_PARSE_BAD_SOF:       return "bad start byte";
+    case BF63112_PARSE_BAD_LENGTH:    return "bad length field";
+    case BF63112_PARSE_BAD_MAGIC:     return "bad command magic";
+    case BF63112_PARSE_BAD_DATA_LEN:  return "data_len exceeds block";
+    case BF63112_PARSE_BAD_CRC:       return "CRC mismatch";
+    }
+  return "unknown";
+}
+
+enum bf63112_parse_result
+bf63112_parse_frame (const uint8_t *buf, size_t len,
+                     struct bf63112_frame *out)
+{
+  uint32_t length, block, data_len, want, got;
+  size_t min_size = BF63112_FRAME_MIN_SIZE;
+
+  if (buf == NULL || out == NULL)
+    return BF63112_PARSE_TRUNCATED;
+  if (len < min_size)
+    return BF63112_PARSE_TRUNCATED;
+  if (buf[0] != BF63112_SOF)
+    return BF63112_PARSE_BAD_SOF;
+
+  length = get_le32 (buf + BF63112_OFF_LEN);
+  if (length != len - BF63112_FRAME_OVERHEAD)
+    return BF63112_PARSE_BAD_LENGTH;
+
+  block = length - 4 - BF63112_HDR_RESERVED;
+  if (block < BF63112_ALIGN || (block % BF63112_ALIGN) != 0)
+    return BF63112_PARSE_BAD_LENGTH;
+
+  if (buf[BF63112_OFF_MAGIC] != BF63112_CMD_MAGIC)
+    return BF63112_PARSE_BAD_MAGIC;
+
+  data_len = get_le32 (buf + BF63112_OFF_DATA_LEN);
+  if (data_len > block - BF63112_CMD_BLOCK_FIXED)
+    return BF63112_PARSE_BAD_DATA_LEN;
+
+  want = bf63112_crc32 (buf, len - 4);
+  got = get_le32 (buf + len - 4);
+  if (want != got)
+    return BF63112_PARSE_BAD_CRC;
+
+  out->opcode = buf[BF63112_OFF_OPCODE];
+  out->phase = buf[BF63112_OFF_PHASE];
+  out->status = buf[BF63112_OFF_STATUS];
+  out->arg = get_le16 (buf + BF63112_OFF_ARG);
+  out->data_len = data_len;
+  out->length_field = length;
+  out->crc = got;
+  out->size = len;
+  out->data = buf + BF63112_OFF_DATA;
+  return BF63112_PARSE_OK;
+}
+
+enum bf63112_scan_result
+bf63112_scan_frame (const uint8_t *buf, size_t len,
+                    size_t *offset, struct bf63112_frame *out)
+{
+  size_t pos = 0;
+  size_t first_candidate = (size_t) -1;
+  int saw_truncated = 0;
+  int saw_corrupt = 0;
+
+  if (offset != NULL)
+    *offset = 0;
+  if (buf == NULL || out == NULL)
+    return BF63112_SCAN_NO_FRAME;
+
+  while (pos < len)
+    {
+      uint32_t total;
+      enum bf63112_parse_result result;
+
+      if (buf[pos] != BF63112_SOF)
+        {
+          pos++;
+          continue;
+        }
+      if (first_candidate == (size_t) -1)
+        first_candidate = pos;
+      if (pos + BF63112_FRAME_OVERHEAD > len)
+        {
+          saw_truncated = 1;
+          break;
+        }
+      total = get_le32 (buf + pos + BF63112_OFF_LEN) + BF63112_FRAME_OVERHEAD;
+      if (total < BF63112_FRAME_MIN_SIZE)
+        {
+          saw_corrupt = 1;
+          pos++;
+          continue;
+        }
+      if (pos + total > len)
+        {
+          saw_truncated = 1;
+          break;
+        }
+      result = bf63112_parse_frame (buf + pos, total, out);
+      if (result == BF63112_PARSE_OK)
+        {
+          if (offset != NULL)
+            *offset = pos;
+          return BF63112_SCAN_OK;
+        }
+      saw_corrupt = 1;
+      pos++;                            /* resynchronise one byte later */
+    }
+
+  if (offset != NULL)
+    *offset = (first_candidate == (size_t) -1) ? 0 : first_candidate;
+  if (saw_truncated)
+    return BF63112_SCAN_TRUNCATED;
+  if (saw_corrupt)
+    return BF63112_SCAN_CORRUPT;
+  return BF63112_SCAN_NO_FRAME;
+}
+
+/* ---- GET_IMG_DATA ------------------------------------------------------- */
+
+enum bf63112_image_result
+bf63112_image_header_parse (const uint8_t *buf, size_t len,
+                            struct bf63112_image_header *out)
+{
+  if (buf == NULL || out == NULL || len < BF63112_IMAGE_HEADER_SIZE)
+    return BF63112_IMAGE_ERR_HEADER;
+  out->status = buf[0];
+  out->total_bytes = get_le32 (buf + 4);
+  out->byte_sum = get_le32 (buf + 0x14);
+  return BF63112_IMAGE_OK;
+}
+
+size_t
+bf63112_image_header_build (const struct bf63112_image_header *header,
+                            uint8_t *out, size_t out_size)
+{
+  if (header == NULL || out == NULL || out_size < BF63112_IMAGE_HEADER_SIZE)
+    return 0;
+  memset (out, 0, BF63112_IMAGE_HEADER_SIZE);
+  out[0] = header->status;
+  put_le32 (out + 4, header->total_bytes);
+  put_le32 (out + 0x14, header->byte_sum);
+  return BF63112_IMAGE_HEADER_SIZE;
+}
+
+void
+bf63112_image_init (struct bf63112_image_assembler *asm_,
+                    uint8_t *buf, size_t capacity,
+                    const struct bf63112_image_header *header,
+                    size_t max_chunk)
+{
+  memset (asm_, 0, sizeof (*asm_));
+  asm_->buf = buf;
+  asm_->capacity = capacity;
+  asm_->total_bytes = header->total_bytes;
+  asm_->expected_sum8 = (uint8_t) (header->byte_sum & 0xFF);
+  asm_->max_chunk = max_chunk;
+}
+
+enum bf63112_image_result
+bf63112_image_add (struct bf63112_image_assembler *asm_,
+                   const uint8_t *chunk, size_t len,
+                   const uint8_t *chunk_sum)
+{
+  if (asm_ == NULL || chunk == NULL || len == 0)
+    return BF63112_IMAGE_ERR_STATE;
+  if (len > asm_->max_chunk)
+    return BF63112_IMAGE_ERR_OVERSIZE;
+  if (chunk_sum != NULL && bf63112_sum8 (chunk, len) != *chunk_sum)
+    return BF63112_IMAGE_ERR_CHUNK_SUM;
+  if (asm_->received + len > asm_->total_bytes)
+    return BF63112_IMAGE_ERR_OVERRUN;
+  if (asm_->buf == NULL || asm_->received + len > asm_->capacity)
+    return BF63112_IMAGE_ERR_STATE;
+  memcpy (asm_->buf + asm_->received, chunk, len);
+  asm_->received += len;
+  asm_->sum = (uint8_t) (asm_->sum + bf63112_sum8 (chunk, len));
+  return BF63112_IMAGE_OK;
+}
+
+enum bf63112_image_result
+bf63112_image_finish (const struct bf63112_image_assembler *asm_)
+{
+  if (asm_ == NULL || asm_->buf == NULL)
+    return BF63112_IMAGE_ERR_STATE;
+  if (asm_->received != asm_->total_bytes)
+    return BF63112_IMAGE_ERR_SHORT;
+  if (asm_->sum != asm_->expected_sum8)
+    return BF63112_IMAGE_ERR_SUM;
+  return BF63112_IMAGE_OK;
+}
+
+/* ---- safety ------------------------------------------------------------- */
+
+int
+bf63112_opcode_is_destructive (uint8_t opcode)
+{
+  switch (opcode)
+    {
+    case BF63112_OP_ENROLL_FINGERPRINT:
+    case BF63112_OP_REMOVE_FINGERPRINT:
+    case BF63112_OP_JTAG_CONTROL:
+    case BF63112_OP_RESTORE_MCU:
+    case BF63112_OP_UPDATE_FIRMWARE:
+    case BF63112_OP_FW_WORK_MODE_SWITCH:
+      return 1;
+    default:
+      return 0;
+    }
+}
+
+const char *
+bf63112_opcode_name (uint8_t opcode)
+{
+  switch (opcode)
+    {
+    case BF63112_OP_QUERY_FIRMWARE_VER:
+      return "CMD_QUERY_FIRMWARE_VER";
+    case BF63112_OP_QUERY_MODULE_SCHEME_INFORMATION:
+      return "CMD_QUERY_MODULE_SCHEME_INFORMATION";
+    case BF63112_OP_QUERY_ROOT_KEY:
+      return "CMD_QUERY_ROOT_KEY";
+    case BF63112_OP_ENROLL_FINGERPRINT:
+      return "CMD_ENROLL_FINGERPRINT";
+    case BF63112_OP_IDENTIFY_FINGERPRINT:
+      return "CMD_IDENTIFY_FINGERPRINT";
+    case BF63112_OP_REMOVE_FINGERPRINT:
+      return "CMD_REMOVE_FINGERPRINT";
+    case BF63112_OP_QUERY_FINGERPRINT_COUNT:
+      return "CMD_QUERY_FINGERPRINT_COUNT";
+    case BF63112_OP_GET_IMG_DATA:
+      return "CMD_GET_IMG_DATA";
+    case BF63112_OP_DETECT_FINGERPRINT_PRESS:
+      return "CMD_DETECT_FINGERPRINT_PRESS";
+    case BF63112_OP_SLEEP:
+      return "CMD_SLEEP";
+    case BF63112_OP_QUERY_MODULE_UID:
+      return "CMD_QUERY_MODULE_UID";
+    case BF63112_OP_QUERY_SENSOR_INFO:
+      return "CMD_QUERY_SENSOR_INFO";
+    case BF63112_OP_JTAG_CONTROL:
+      return "CMD_JTAG_CONTROL";
+    case BF63112_OP_RESTORE_MCU:
+      return "CMD_RESTORE_MCU";
+    case BF63112_OP_UPDATE_FIRMWARE:
+      return "CMD_UPDATE_FIRMWARE";
+    case BF63112_OP_FW_WORK_MODE_SWITCH:
+      return "CMD_FW_WORK_MODE_SWITCH";
+    default:
+      return NULL;
+    }
+}
diff --git a/libfprint/drivers/bf63112_proto.h b/libfprint/drivers/bf63112_proto.h
new file mode 100644
index 00000000..3e702fcb
--- /dev/null
+++ b/libfprint/drivers/bf63112_proto.h
@@ -0,0 +1,254 @@
+/* TODO(licence): SPDX-License-Identifier to be set before submission;
+ * the project owner has not chosen the licence for this subtree yet. */
+/*
+ * bf63112_proto.h - dependency-free BF63112 frame protocol.
+ *
+ * A small C implementation of the recovered frame format for the Betterlife
+ * BF63112 fingerprint module on Intel SPI (ONEXPLAYER 3, ACPI\BF63112).
+ * Only <stdint.h>/<stddef.h> are needed, so this file is shared by the
+ * libfprint driver and by the offline tests.
+ *
+ * Frame layout, recovered byte for byte from the vendor Windows UMDF driver:
+ *
+ *   AA | L:u32 LE | 16 x 0 | 4C op phase 00 arg:u16 len:u32 data | pad16 | CRC-32
+ *   L = 20 + align16 (10 + data_len)          (bytes after the SOF, no CRC)
+ *   CRC-32/ISO-HDLC over everything before it, including the 0xAA.
+ *
+ * This is our own code.  It does not touch hardware.
+ */
+
+#ifndef BF63112_PROTO_H
+#define BF63112_PROTO_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ---- recovered constants ------------------------------------------------ */
+
+#define BF63112_SOF             0xAAu
+#define BF63112_CMD_MAGIC       0x4Cu
+#define BF63112_HDR_RESERVED    16u
+#define BF63112_CMD_BLOCK_FIXED 10u
+#define BF63112_ALIGN           16u
+
+#define BF63112_OFF_LEN       1u
+#define BF63112_OFF_RESERVED  5u
+#define BF63112_OFF_MAGIC     21u
+#define BF63112_OFF_OPCODE    22u
+#define BF63112_OFF_PHASE     23u
+#define BF63112_OFF_STATUS    24u
+#define BF63112_OFF_ARG       25u
+#define BF63112_OFF_DATA_LEN  27u
+#define BF63112_OFF_DATA      31u
+
+/*: 41 bytes for data_len == 0: 25 + align16 (10). */
+#define BF63112_FRAME_MIN_SIZE 41u
+/*: SOF + L field + CRC-32. */
+#define BF63112_FRAME_OVERHEAD 5u
+
+/*: Largest payload this implementation accepts (the wire field is u32). */
+#define BF63112_MAX_DATA_LEN (64u * 1024u)
+
+/*: Chunk ceiling the Windows driver uses for GET_IMG_DATA. */
+#define BF63112_MAX_IMAGE_CHUNK 0x1FCCu
+
+/*: Phases of a multi-step command. */
+enum bf63112_phase
+{
+  BF63112_PHASE_START = 0,
+  BF63112_PHASE_DATA = 1,
+  BF63112_PHASE_FINISH = 2,
+  BF63112_PHASE_CANCEL = 3,
+};
+
+/*: The opcode table, read from the Windows driver's dispatch table (RVA
+ *  0x46F00, stride 0x20).  An earlier revision of this header was shifted by
+ *  one because it was reconstructed from the order of the driver's trace
+ *  strings rather than from the table the driver dispatches on. */
+enum bf63112_opcode
+{
+  BF63112_OP_QUERY_FIRMWARE_VER = 0xA0,
+  BF63112_OP_QUERY_MODULE_SCHEME_INFORMATION = 0xA1,
+  BF63112_OP_QUERY_ROOT_KEY = 0xA2,
+  BF63112_OP_ENROLL_FINGERPRINT = 0xB0,
+  BF63112_OP_IDENTIFY_FINGERPRINT = 0xB1,
+  BF63112_OP_REMOVE_FINGERPRINT = 0xB2,
+  BF63112_OP_QUERY_FINGERPRINT_COUNT = 0xB3,
+  BF63112_OP_GET_IMG_DATA = 0xB4,
+  BF63112_OP_DETECT_FINGERPRINT_PRESS = 0xB5,
+  BF63112_OP_SLEEP = 0xB6,
+  BF63112_OP_QUERY_MODULE_UID = 0xC0,
+  BF63112_OP_QUERY_SENSOR_INFO = 0xC1,
+  BF63112_OP_JTAG_CONTROL = 0xC2,
+  BF63112_OP_RESTORE_MCU = 0xC3,
+  BF63112_OP_UPDATE_FIRMWARE = 0xD0,
+  /*: Not in the driver's table (it ends at 0xD0); kept for source
+   *  compatibility, never sent. */
+  BF63112_OP_FW_WORK_MODE_SWITCH = 0xFF,
+};
+
+/* ---- frame arithmetic and checksums ------------------------------------ */
+
+size_t   bf63112_align16 (size_t n);
+size_t   bf63112_command_block_len (size_t data_len);
+size_t   bf63112_length_field (size_t data_len);
+size_t   bf63112_frame_size (size_t data_len);
+
+uint32_t bf63112_crc32 (const uint8_t *data, size_t len);
+uint8_t  bf63112_sum8 (const uint8_t *data, size_t len);
+
+/* ---- build -------------------------------------------------------------- */
+
+/*!
+ * Build a complete frame into @out.
+ *
+ * @status is the byte at offset 24 (0x00 in every request; answers carry a
+ * status/parameter there - the answer layout is inferred, see the docs).
+ *
+ * Returns the frame size written, or 0 if the arguments are invalid or @out is
+ * too small.  @data may be NULL when @data_len is 0.
+ */
+size_t bf63112_build_frame (uint8_t        opcode,
+                            uint8_t        phase,
+                            uint8_t        status,
+                            uint16_t       arg,
+                            const uint8_t *data,
+                            size_t         data_len,
+                            uint8_t       *out,
+                            size_t         out_size);
+
+/* ---- parse -------------------------------------------------------------- */
+
+enum bf63112_parse_result
+{
+  BF63112_PARSE_OK = 0,
+  BF63112_PARSE_TRUNCATED,
+  BF63112_PARSE_BAD_SOF,
+  BF63112_PARSE_BAD_LENGTH,
+  BF63112_PARSE_BAD_MAGIC,
+  BF63112_PARSE_BAD_DATA_LEN,
+  BF63112_PARSE_BAD_CRC,
+};
+
+struct bf63112_frame
+{
+  uint8_t        opcode;
+  uint8_t        phase;
+  uint8_t        status;
+  uint16_t       arg;
+  uint32_t       data_len;
+  uint32_t       length_field;
+  uint32_t       crc;
+  size_t         size;              /*: complete frame size in bytes */
+  const uint8_t *data;              /*: points into the caller's buffer */
+};
+
+const char *bf63112_parse_result_str (enum bf63112_parse_result result);
+
+/*! Validate and decode exactly one frame occupying @len bytes. */
+enum bf63112_parse_result
+bf63112_parse_frame (const uint8_t *buf, size_t len,
+                     struct bf63112_frame *out);
+
+enum bf63112_scan_result
+{
+  BF63112_SCAN_OK = 0,
+  BF63112_SCAN_NO_FRAME,      /*: nothing in the buffer starts with 0xAA */
+  BF63112_SCAN_TRUNCATED,     /*: a candidate frame is cut short */
+  BF63112_SCAN_CORRUPT,       /*: candidate(s) failed validation */
+};
+
+/*!
+ * Find the first valid frame in @buf, skipping leading padding/junk.
+ *
+ * This is the userspace view of a spidev readback: the answer may be preceded
+ * by 0xFF/0x00 bytes and followed by irrelevant data.  On success @offset
+ * receives the frame start and @out the decoded frame.
+ */
+enum bf63112_scan_result
+bf63112_scan_frame (const uint8_t *buf, size_t len,
+                    size_t *offset, struct bf63112_frame *out);
+
+/* ---- GET_IMG_DATA ------------------------------------------------------- */
+
+/*: Bytes the phase-0 payload must carry: the Windows driver reads a u32 at +4
+ *  and another at +0x14, so the record is 0x18 bytes, not 9. */
+#define BF63112_IMAGE_HEADER_SIZE 0x18
+
+struct bf63112_image_header
+{
+  uint8_t  status;              /*: @0 */
+  uint32_t total_bytes;         /*: @4  */
+  uint32_t byte_sum;            /*: @0x14, only the low 8 bits are checked */
+};
+
+enum bf63112_image_result
+{
+  BF63112_IMAGE_OK = 0,
+  BF63112_IMAGE_ERR_HEADER,     /*: payload shorter than 0x18 bytes */
+  BF63112_IMAGE_ERR_STATE,      /*: assembler misused */
+  BF63112_IMAGE_ERR_OVERSIZE,   /*: chunk above max_chunk */
+  BF63112_IMAGE_ERR_OVERRUN,    /*: chunk would pass total_bytes */
+  BF63112_IMAGE_ERR_SHORT,      /*: finish() with too few bytes */
+  BF63112_IMAGE_ERR_SUM,        /*: global 8-bit sum mismatch */
+  BF63112_IMAGE_ERR_CHUNK_SUM,  /*: optional per-chunk sum mismatch */
+};
+
+/*! Parse the 0x18-byte phase-0 payload: status:u8 @0, total:u32 @4, byte_sum:u32 @0x14. */
+enum bf63112_image_result
+bf63112_image_header_parse (const uint8_t *buf, size_t len,
+                            struct bf63112_image_header *out);
+
+/*! Serialise a phase-0 payload into @out (at least 0x18 bytes). */
+size_t bf63112_image_header_build (const struct bf63112_image_header *header,
+                                   uint8_t *out, size_t out_size);
+
+/*!
+ * Reassemble a GET_IMG image into a caller-provided buffer.
+ *
+ * No allocation happens here: the driver sizes its buffer from the header.
+ * @capacity must be at least header->total_bytes.
+ */
+struct bf63112_image_assembler
+{
+  uint8_t *buf;
+  size_t   capacity;
+  size_t   received;
+  uint8_t  sum;
+  uint32_t total_bytes;
+  uint8_t  expected_sum8;
+  size_t   max_chunk;
+};
+
+void bf63112_image_init (struct bf63112_image_assembler *asm_,
+                         uint8_t *buf, size_t capacity,
+                         const struct bf63112_image_header *header,
+                         size_t max_chunk);
+
+/*! Append one chunk; @chunk_sum is checked only when it is non-NULL. */
+enum bf63112_image_result
+bf63112_image_add (struct bf63112_image_assembler *asm_,
+                   const uint8_t *chunk, size_t len,
+                   const uint8_t *chunk_sum);
+
+/*! Validate size and global sum; returns OK only for a complete image. */
+enum bf63112_image_result
+bf63112_image_finish (const struct bf63112_image_assembler *asm_);
+
+/* ---- safety ------------------------------------------------------------- */
+
+/*! TRUE for opcodes that can erase templates, JTAG or reflash the MCU. */
+int bf63112_opcode_is_destructive (uint8_t opcode);
+
+/*! Human-readable command name ("CMD_..."), or NULL for unknown bytes. */
+const char *bf63112_opcode_name (uint8_t opcode);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* BF63112_PROTO_H */
diff --git a/libfprint/drivers/bf63112_spi.c b/libfprint/drivers/bf63112_spi.c
new file mode 100644
index 00000000..bed2f653
--- /dev/null
+++ b/libfprint/drivers/bf63112_spi.c
@@ -0,0 +1,1894 @@
+/* TODO(licence): SPDX-License-Identifier to be set before submission;
+ * the project owner has not chosen the licence for this subtree yet. */
+/*
+ * bf63112_spi.c - dependency-free BF63112 SPI (ACPI/SPB) transport.
+ *
+ * See bf63112_spi.h for the wire shape and the safety model.  It uses
+ * libc/syscalls only (no libgpiod, no libfprint, no spidev helper).  Optional libgpiod v2/v1
+ * backends are compiled only when BF63112_HAVE_GPIOD_V2/_V1 is defined.
+ *
+ * Nothing here is claimed to have run against the sensor.  The transport is
+ * driven through an injected I/O vtable and a fake clock by the tests, so it
+ * never needs /dev/spidev or a GPIO.
+ */
+
+#include "bf63112_spi.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <time.h>
+#include <unistd.h>
+
+#if defined(BF63112_HAVE_GPIOD_V2) || defined(BF63112_HAVE_GPIOD_V1)
+#include <gpiod.h>
+#endif
+
+struct bf63112_spi_ioc_transfer
+{
+  uint64_t tx_buf;
+  uint64_t rx_buf;
+  uint32_t len;
+  uint32_t speed_hz;
+  uint16_t delay_usecs;
+  uint8_t  bits_per_word;
+  uint8_t  cs_change;
+  uint8_t  tx_nbits;
+  uint8_t  rx_nbits;
+  uint8_t  word_delay_usecs;
+  uint8_t  pad;
+};
+
+/* 32 bytes is what SPI_IOC_MESSAGE(n) encodes; a change here breaks the ABI. */
+_Static_assert (sizeof (struct bf63112_spi_ioc_transfer) == 32,
+                "spi_ioc_transfer must be 32 bytes");
+
+/* ------------------------------------------------------------- small utils */
+
+static uint64_t
+default_now_ms (void *ctx)
+{
+  struct timespec ts;
+
+  (void) ctx;
+  clock_gettime (CLOCK_MONOTONIC, &ts);
+  return (uint64_t) ts.tv_sec * 1000u + (uint64_t) ts.tv_nsec / 1000000u;
+}
+
+static void
+default_sleep_ms (unsigned int ms, void *ctx)
+{
+  struct timespec ts;
+
+  (void) ctx;
+  ts.tv_sec = (time_t) (ms / 1000u);
+  ts.tv_nsec = (long) (ms % 1000u) * 1000000L;
+  while (nanosleep (&ts, &ts) < 0 && errno == EINTR)
+    ;
+}
+
+static uint64_t
+spi_now_ms (struct bf63112_spi *spi)
+{
+  uint64_t (*now) (void *) = spi->now_ms ? spi->now_ms : default_now_ms;
+
+  return now (spi->now_ctx);
+}
+
+static void
+spi_sleep_ms (struct bf63112_spi *spi, unsigned int ms)
+{
+  void (*sleep_ms) (unsigned int, void *) =
+    spi->sleep_ms ? spi->sleep_ms : default_sleep_ms;
+
+  if (ms > 0)
+    sleep_ms (ms, spi->sleep_ctx);
+}
+
+static int
+neg_errno (void)
+{
+  return errno != 0 ? -errno : BF63112_SPI_ERR_IO;
+}
+
+static int
+write_all (int fd, const char *text)
+{
+  size_t left = strlen (text);
+
+  while (left > 0)
+    {
+      ssize_t written = write (fd, text, left);
+
+      if (written < 0)
+        {
+          if (errno == EINTR)
+            continue;
+          return neg_errno ();
+        }
+      text += written;
+      left -= (size_t) written;
+    }
+  return 0;
+}
+
+static int
+write_sysfs (const char *path, const char *text)
+{
+  int fd = open (path, O_WRONLY | O_CLOEXEC);
+  int rc;
+
+  if (fd < 0)
+    return neg_errno ();
+  rc = write_all (fd, text);
+  if (close (fd) < 0 && rc == 0)
+    rc = neg_errno ();
+  return rc;
+}
+
+static int
+write_sysfs_int (const char *path, int value)
+{
+  char buf[24];
+
+  snprintf (buf, sizeof buf, "%d", value);
+  return write_sysfs (path, buf);
+}
+
+static int
+read_sysfs_int (const char *path)
+{
+  char buf[32];
+  int fd = open (path, O_RDONLY | O_CLOEXEC);
+  ssize_t got;
+
+  if (fd < 0)
+    return neg_errno ();
+  do
+    got = read (fd, buf, sizeof buf - 1);
+  while (got < 0 && errno == EINTR);
+  close (fd);
+  if (got < 0)
+    return neg_errno ();
+  if (got == 0)
+    return BF63112_SPI_ERR_IO;
+  buf[got] = '\0';
+  if (buf[0] != '0' && buf[0] != '1')
+    return BF63112_SPI_ERR_IO;
+  return buf[0] == '1' ? 1 : 0;
+}
+
+static bool
+path_is_dir (const char *path)
+{
+  int fd = open (path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+
+  if (fd < 0)
+    return false;
+  close (fd);
+  return true;
+}
+
+static bool
+wait_for_path (const char *path, unsigned int timeout_ms)
+{
+  unsigned int slept = 0;
+
+  while (!path_is_dir (path))
+    {
+      struct timespec ts = { 0, 10 * 1000 * 1000L };
+
+      if (slept >= timeout_ms)
+        return false;
+      while (nanosleep (&ts, &ts) < 0 && errno == EINTR)
+        ;
+      slept += 10;
+    }
+  return true;
+}
+
+/* ---------------------------------------------------------------- selector */
+
+uint8_t
+bf63112_spi_selector (uint8_t opcode, bool write)
+{
+  uint8_t value = (uint8_t) ((opcode & 0x3Fu) << 1);
+
+  return write ? (uint8_t) (value | 0x80u) : value;
+}
+
+uint8_t
+bf63112_spi_selector_low (uint8_t opcode)
+{
+  return (uint8_t) (bf63112_spi_selector (opcode, false) & 0x7Fu);
+}
+
+struct destructive_op
+{
+  uint8_t     opcode;
+  const char *name;
+};
+
+static const struct destructive_op destructive_ops[] = {
+  { 0xB0, "ENROLL_FINGERPRINT" },
+  { 0xB1, "IDENTIFY_FINGERPRINT" },
+  { 0xB2, "REMOVE_FINGERPRINT" },
+  { 0xC2, "JTAG_CONTROL" },
+  { 0xC3, "RESTORE_MCU" },
+  { 0xD0, "UPDATE_FIRMWARE" },
+  { 0xD1, "FW_WORK_MODE_SWITCH" },
+  { 0xFF, "FW_WORK_MODE_SWITCH" },
+};
+
+#define DESTRUCTIVE_OP_COUNT \
+  (sizeof destructive_ops / sizeof destructive_ops[0])
+
+bool
+bf63112_spi_opcode_is_destructive (uint8_t opcode)
+{
+  size_t i;
+
+  for (i = 0; i < DESTRUCTIVE_OP_COUNT; i++)
+    if (destructive_ops[i].opcode == opcode)
+      return true;
+  return false;
+}
+
+const char *
+bf63112_spi_destructive_name (uint8_t opcode)
+{
+  size_t i;
+
+  for (i = 0; i < DESTRUCTIVE_OP_COUNT; i++)
+    if (destructive_ops[i].opcode == opcode)
+      return destructive_ops[i].name;
+  return NULL;
+}
+
+bool
+bf63112_spi_selector_is_forbidden (uint8_t selector)
+{
+  size_t i;
+  uint8_t low = (uint8_t) (selector & 0x7Fu);
+
+  for (i = 0; i < DESTRUCTIVE_OP_COUNT; i++)
+    if (bf63112_spi_selector_low (destructive_ops[i].opcode) == low)
+      return true;
+  return false;
+}
+
+const char *
+bf63112_spi_selector_aliases (uint8_t selector)
+{
+  static char buf[192];
+  size_t i, used = 0;
+  uint8_t low = (uint8_t) (selector & 0x7Fu);
+
+  buf[0] = '\0';
+  for (i = 0; i < DESTRUCTIVE_OP_COUNT; i++)
+    {
+      int written;
+
+      if (bf63112_spi_selector_low (destructive_ops[i].opcode) != low)
+        continue;
+      written = snprintf (buf + used, sizeof buf - used, "%s0x%02x %s",
+                          used ? ", " : "", destructive_ops[i].opcode,
+                          destructive_ops[i].name);
+      if (written < 0 || (size_t) written >= sizeof buf - used)
+        break;
+      used += (size_t) written;
+    }
+  return used ? buf : NULL;
+}
+
+/* ---------------------------------------------------------------- policy */
+
+void
+bf63112_spi_policy_init (struct bf63112_spi_policy *policy)
+{
+  if (policy == NULL)
+    return;
+  memset (policy, 0, sizeof *policy);
+  policy->allow_io = false;
+  bf63112_spi_policy_allow_read (policy, BF63112_SPI_OP_FIRMWARE_VER);
+  bf63112_spi_policy_allow_read (policy, BF63112_SPI_OP_MODULE_SCHEME);
+  bf63112_spi_policy_allow_read (policy, BF63112_SPI_OP_FINGER_COUNT);
+  bf63112_spi_policy_allow_read (policy, BF63112_SPI_OP_MODULE_UID);
+  bf63112_spi_policy_allow_read (policy, BF63112_SPI_OP_SENSOR_INFO);
+  bf63112_spi_policy_allow_read (policy, BF63112_SPI_OP_STATUS_REG);
+}
+
+static void
+allow_op (uint64_t bitmap[4], uint8_t opcode)
+{
+  bitmap[opcode >> 6] |= 1ULL << (opcode & 63u);
+}
+
+static bool
+op_allowed (const uint64_t bitmap[4], uint8_t opcode)
+{
+  return (bitmap[opcode >> 6] & (1ULL << (opcode & 63u))) != 0;
+}
+
+void
+bf63112_spi_policy_allow_read (struct bf63112_spi_policy *policy,
+                               uint8_t opcode)
+{
+  if (policy != NULL)
+    allow_op (policy->read_allow, opcode);
+}
+
+void
+bf63112_spi_policy_allow_write (struct bf63112_spi_policy *policy,
+                                uint8_t opcode)
+{
+  if (policy != NULL)
+    allow_op (policy->write_allow, opcode);
+}
+
+bool
+bf63112_spi_policy_read_allowed (const struct bf63112_spi_policy *policy,
+                                 uint8_t opcode)
+{
+  return policy != NULL && op_allowed (policy->read_allow, opcode);
+}
+
+bool
+bf63112_spi_policy_write_allowed (const struct bf63112_spi_policy *policy,
+                                  uint8_t opcode)
+{
+  return policy != NULL && op_allowed (policy->write_allow, opcode);
+}
+
+int
+bf63112_spi_policy_check (const struct bf63112_spi_policy *policy,
+                          uint8_t opcode, bool write)
+{
+  if (policy == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  if (bf63112_spi_opcode_is_destructive (opcode))
+    return BF63112_SPI_ERR_REFUSED;
+  if (bf63112_spi_selector_is_forbidden (bf63112_spi_selector_low (opcode)))
+    return BF63112_SPI_ERR_REFUSED;
+  if (!policy->allow_io)
+    return BF63112_SPI_ERR_NOT_ALLOWED;
+  if (write)
+    return bf63112_spi_policy_write_allowed (policy, opcode)
+           ? 0 : BF63112_SPI_ERR_NOT_ALLOWED;
+  return bf63112_spi_policy_read_allowed (policy, opcode)
+         ? 0 : BF63112_SPI_ERR_NOT_ALLOWED;
+}
+
+/* ---------------------------------------------------------------- plans */
+
+void
+bf63112_spi_default_timeouts (uint8_t opcode,
+                              uint16_t *timeout_ms, uint16_t *total_ms)
+{
+  uint16_t per = (uint16_t) BF63112_SPI_CMD_TIMEOUT_MS;
+  uint16_t total = (uint16_t) BF63112_SPI_CMD_TOTAL_MS;
+
+  if (opcode == 0xB4)   /* GET_IMG_DATA */
+    {
+      per = (uint16_t) BF63112_SPI_IMAGE_TIMEOUT_MS;
+      total = (uint16_t) BF63112_SPI_IMAGE_TOTAL_MS;
+    }
+  else if (opcode == 0xC3)   /* RESTORE_MCU */
+    {
+      per = (uint16_t) BF63112_SPI_RESTORE_TIMEOUT_MS;
+      total = (uint16_t) BF63112_SPI_RESTORE_TOTAL_MS;
+    }
+  if (timeout_ms != NULL)
+    *timeout_ms = per;
+  if (total_ms != NULL)
+    *total_ms = total;
+}
+
+static int
+resolve_timeouts (uint8_t opcode, uint16_t timeout_ms, uint16_t total_ms,
+                  uint16_t *out_timeout, uint16_t *out_total)
+{
+  if (timeout_ms == 0 || total_ms == 0)
+    bf63112_spi_default_timeouts (opcode, out_timeout, out_total);
+  else
+    {
+      *out_timeout = timeout_ms;
+      *out_total = total_ms;
+    }
+  if (*out_timeout == 0 || *out_total == 0 || *out_total < *out_timeout)
+    return BF63112_SPI_ERR_INVALID;
+  return 0;
+}
+
+int
+bf63112_spi_build_read (const struct bf63112_spi_policy *policy,
+                        uint8_t opcode, uint16_t read_len,
+                        uint16_t timeout_ms, uint16_t total_ms,
+                        struct bf63112_spi_plan *plan)
+{
+  int rc;
+
+  if (plan == NULL || read_len == 0)
+    return BF63112_SPI_ERR_INVALID;
+  rc = bf63112_spi_policy_check (policy, opcode, false);
+  if (rc != 0)
+    return rc;
+  memset (plan, 0, sizeof *plan);
+  plan->opcode = opcode;
+  plan->write = false;
+  plan->read_len = read_len;
+  rc = resolve_timeouts (opcode, timeout_ms, total_ms,
+                         &plan->timeout_ms, &plan->total_ms);
+  if (rc != 0)
+    return rc;
+  plan->selector = bf63112_spi_selector (opcode, false);
+  plan->selector_byte = plan->selector;
+  plan->transfers[0].tx = &plan->selector_byte;
+  plan->transfers[0].tx_len = 1;
+  plan->transfers[0].rx_len = 0;
+  plan->transfers[1].tx = NULL;
+  plan->transfers[1].tx_len = 0;
+  plan->transfers[1].rx = NULL;
+  plan->transfers[1].rx_len = read_len;
+  plan->n_transfers = 2;
+  return bf63112_spi_plan_validate (plan);
+}
+
+int
+bf63112_spi_build_write (const struct bf63112_spi_policy *policy,
+                         uint8_t opcode, const uint8_t *payload,
+                         size_t payload_len,
+                         uint16_t timeout_ms, uint16_t total_ms,
+                         struct bf63112_spi_plan *plan)
+{
+  int rc;
+
+  if (plan == NULL || (payload == NULL && payload_len > 0))
+    return BF63112_SPI_ERR_INVALID;
+  if (payload_len > 0xFFFFFFFFu)
+    return BF63112_SPI_ERR_INVALID;
+  rc = bf63112_spi_policy_check (policy, opcode, true);
+  if (rc != 0)
+    return rc;
+  memset (plan, 0, sizeof *plan);
+  plan->opcode = opcode;
+  plan->write = true;
+  plan->read_len = 0;
+  rc = resolve_timeouts (opcode, timeout_ms, total_ms,
+                         &plan->timeout_ms, &plan->total_ms);
+  if (rc != 0)
+    return rc;
+  plan->selector = bf63112_spi_selector (opcode, true);
+  plan->selector_byte = plan->selector;
+  plan->transfers[0].tx = &plan->selector_byte;
+  plan->transfers[0].tx_len = 1;
+  plan->transfers[0].rx_len = 0;
+  plan->n_transfers = 1;
+  if (payload_len > 0)
+    {
+      plan->transfers[1].tx = payload;
+      plan->transfers[1].tx_len = payload_len;
+      plan->transfers[1].rx_len = 0;
+      plan->n_transfers = 2;
+    }
+  return bf63112_spi_plan_validate (plan);
+}
+
+int
+bf63112_spi_plan_validate (const struct bf63112_spi_plan *plan)
+{
+  if (plan == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  if (plan->n_transfers < 1 || plan->n_transfers > BF63112_SPI_MAX_TRANSFERS)
+    return BF63112_SPI_ERR_INVALID;
+  if (plan->selector != bf63112_spi_selector (plan->opcode, plan->write))
+    return BF63112_SPI_ERR_INVALID;
+  if (plan->transfers[0].tx == NULL || plan->transfers[0].tx_len != 1 ||
+      plan->transfers[0].tx[0] != plan->selector ||
+      plan->transfers[0].rx_len != 0)
+    return BF63112_SPI_ERR_INVALID;
+  if (plan->timeout_ms == 0 || plan->total_ms < plan->timeout_ms)
+    return BF63112_SPI_ERR_INVALID;
+  if (plan->write)
+    {
+      if (plan->read_len != 0)
+        return BF63112_SPI_ERR_INVALID;
+      if (plan->n_transfers == 2 && plan->transfers[1].tx_len == 0)
+        return BF63112_SPI_ERR_INVALID;
+      if (plan->transfers[0].rx_len || plan->transfers[1].rx_len)
+        return BF63112_SPI_ERR_INVALID;
+    }
+  else
+    {
+      if (plan->n_transfers != 2 || plan->read_len == 0)
+        return BF63112_SPI_ERR_INVALID;
+      if (plan->transfers[1].tx != NULL || plan->transfers[1].tx_len != 0 ||
+          plan->transfers[1].rx_len != plan->read_len)
+        return BF63112_SPI_ERR_INVALID;
+    }
+  return 0;
+}
+
+enum bf63112_spi_deadline
+bf63112_spi_deadline_check (const struct bf63112_spi_plan *plan,
+                            uint64_t elapsed_ms)
+{
+  if (plan == NULL)
+    return BF63112_SPI_DEADLINE_OK;
+  if (elapsed_ms > plan->total_ms)
+    return BF63112_SPI_DEADLINE_TOTAL;
+  if (elapsed_ms > plan->timeout_ms)
+    return BF63112_SPI_DEADLINE_ATTEMPT;
+  return BF63112_SPI_DEADLINE_OK;
+}
+
+int64_t
+bf63112_spi_irq_budget (const struct bf63112_spi_plan *plan,
+                        uint64_t elapsed_ms)
+{
+  uint64_t limit;
+
+  if (plan == NULL)
+    return 0;
+  limit = plan->timeout_ms < plan->total_ms ? plan->timeout_ms
+                                            : plan->total_ms;
+  return (int64_t) limit - (int64_t) elapsed_ms;
+}
+
+static int
+plan_deadline_rc (const struct bf63112_spi_plan *plan, uint64_t elapsed_ms)
+{
+  switch (bf63112_spi_deadline_check (plan, elapsed_ms))
+    {
+    case BF63112_SPI_DEADLINE_TOTAL:
+    case BF63112_SPI_DEADLINE_ATTEMPT:
+      return BF63112_SPI_ERR_TIMEOUT;
+    case BF63112_SPI_DEADLINE_OK:
+    default:
+      return 0;
+    }
+}
+
+/* ------------------------------------------------------------- linux spidev */
+
+static int
+linux_spi_open (void *priv)
+{
+  struct bf63112_linux_spi *state = priv;
+  int fd;
+
+  if (state == NULL || state->path[0] == '\0')
+    return BF63112_SPI_ERR_INVALID;
+  if (state->fd >= 0)
+    return 0;
+  fd = open (state->path, O_RDWR | O_CLOEXEC);
+  if (fd < 0)
+    return neg_errno ();
+  state->fd = fd;
+  return 0;
+}
+
+static int
+linux_spi_close (void *priv)
+{
+  struct bf63112_linux_spi *state = priv;
+  int rc = 0;
+
+  if (state == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  if (state->fd >= 0)
+    {
+      if (close (state->fd) < 0)
+        rc = neg_errno ();
+      state->fd = -1;
+    }
+  return rc;
+}
+
+static int
+linux_spi_configure (void *priv, int speed_hz, int mode, int bits_per_word)
+{
+  struct bf63112_linux_spi *state = priv;
+
+  if (state == NULL || state->fd < 0)
+    return BF63112_SPI_ERR_INVALID;
+  if (mode >= 0)
+    {
+      uint8_t value = (uint8_t) (mode & 0xFF);
+
+      if (ioctl (state->fd, BF63112_SPI_IOC_WR_MODE, &value) < 0)
+        return neg_errno ();
+    }
+  if (bits_per_word >= 0)
+    {
+      uint8_t value = (uint8_t) (bits_per_word & 0xFF);
+
+      if (ioctl (state->fd, BF63112_SPI_IOC_WR_BITS_PER_WORD, &value) < 0)
+        return neg_errno ();
+    }
+  if (speed_hz >= 0)
+    {
+      uint32_t value = (uint32_t) speed_hz;
+
+      if (ioctl (state->fd, BF63112_SPI_IOC_WR_MAX_SPEED_HZ, &value) < 0)
+        return neg_errno ();
+    }
+  return 0;
+}
+
+static int
+linux_spi_message (void *priv,
+                   const struct bf63112_spi_transfer *transfers,
+                   size_t n_transfers, size_t *bytes_done)
+{
+  struct bf63112_linux_spi *state = priv;
+  struct bf63112_spi_ioc_transfer xfer[BF63112_SPI_MAX_TRANSFERS];
+  size_t i;
+  int rc;
+
+  if (state == NULL || state->fd < 0 || transfers == NULL ||
+      n_transfers == 0 || n_transfers > BF63112_SPI_MAX_TRANSFERS)
+    return BF63112_SPI_ERR_INVALID;
+  memset (xfer, 0, sizeof xfer);
+  for (i = 0; i < n_transfers; i++)
+    {
+      size_t len = transfers[i].tx_len > transfers[i].rx_len
+                   ? transfers[i].tx_len : transfers[i].rx_len;
+
+      if (len == 0 || len > 0xFFFFFFFFu)
+        return BF63112_SPI_ERR_INVALID;
+      xfer[i].tx_buf = (uint64_t) (uintptr_t) transfers[i].tx;
+      xfer[i].rx_buf = (uint64_t) (uintptr_t) transfers[i].rx;
+      xfer[i].len = (uint32_t) len;
+      xfer[i].speed_hz = transfers[i].speed_hz;
+      xfer[i].delay_usecs = transfers[i].delay_us;
+    }
+  rc = ioctl (state->fd, BF63112_SPI_IOC_MESSAGE (n_transfers), xfer);
+  if (rc < 0)
+    return neg_errno ();
+  if (bytes_done != NULL)
+    *bytes_done = (size_t) rc;
+  return 0;
+}
+
+static const struct bf63112_spi_io linux_spi_ops = {
+  .open = linux_spi_open,
+  .close = linux_spi_close,
+  .configure = linux_spi_configure,
+  .message = linux_spi_message,
+};
+
+int
+bf63112_spi_linux_init (struct bf63112_spi *spi,
+                        struct bf63112_linux_spi *state,
+                        const char *path)
+{
+  size_t len;
+
+  if (spi == NULL || state == NULL || path == NULL || *path == '\0')
+    return BF63112_SPI_ERR_INVALID;
+  len = strlen (path);
+  if (len >= sizeof state->path)
+    return BF63112_SPI_ERR_INVALID;
+  memset (state, 0, sizeof *state);
+  memcpy (state->path, path, len + 1);
+  state->fd = -1;
+  bf63112_spi_init (spi, &linux_spi_ops, state);
+  return 0;
+}
+
+/* --------------------------------------------------------------- sysfs IRQ */
+
+static const char *
+edge_name (int edge)
+{
+  switch (edge)
+    {
+    case BF63112_SPI_IRQ_FALLING:
+      return "falling";
+    case BF63112_SPI_IRQ_BOTH:
+      return "both";
+    case BF63112_SPI_IRQ_RISING:
+    default:
+      return "rising";
+    }
+}
+
+static int
+sysfs_irq_open (struct bf63112_spi_irq *irq)
+{
+  struct bf63112_sysfs_irq *state = irq->priv;
+  char path[320];
+  int rc;
+
+  if (state == NULL || state->line < 0)
+    return BF63112_SPI_ERR_INVALID;
+  if (state->value_fd >= 0)
+    return 0;
+  if (!path_is_dir (state->base))
+    return BF63112_SPI_ERR_IO;
+  snprintf (path, sizeof path, "%s/gpio%d", state->base, state->line);
+  if (!path_is_dir (path))
+    {
+      snprintf (path, sizeof path, "%s/export", state->base);
+      rc = write_sysfs_int (path, state->line);
+      if (rc != 0)
+        return rc;
+      state->exported_here = true;
+      snprintf (path, sizeof path, "%s/gpio%d", state->base, state->line);
+      if (!wait_for_path (path, 500))
+        return BF63112_SPI_ERR_TIMEOUT;
+    }
+  snprintf (path, sizeof path, "%s/gpio%d/direction", state->base,
+            state->line);
+  rc = write_sysfs (path, "in");
+  if (rc != 0)
+    return rc;
+  snprintf (path, sizeof path, "%s/gpio%d/edge", state->base, state->line);
+  rc = write_sysfs (path, edge_name (state->edge));
+  if (rc != 0)
+    return rc;
+
+  state->hw_active_low = false;
+  snprintf (path, sizeof path, "%s/gpio%d/active_low", state->base,
+            state->line);
+  if (access (path, F_OK) == 0)
+    {
+      rc = write_sysfs (path, state->active_low ? "1" : "0");
+      if (rc == 0)
+        state->hw_active_low = true;
+    }
+
+  snprintf (path, sizeof path, "%s/gpio%d/value", state->base, state->line);
+  state->value_fd = open (path, O_RDONLY | O_CLOEXEC);
+  if (state->value_fd < 0)
+    return neg_errno ();
+  state->last_value = read_sysfs_int (path);
+  return state->last_value < 0 ? state->last_value : 0;
+}
+
+static int
+sysfs_irq_wait (struct bf63112_spi_irq *irq, unsigned int timeout_ms,
+                struct bf63112_spi_irq_event *event)
+{
+  struct bf63112_sysfs_irq *state = irq->priv;
+  struct pollfd pfd;
+  char path[320];
+  int raw, value, rc;
+  uint64_t started;
+
+  if (state == NULL || state->value_fd < 0 || event == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  memset (event, 0, sizeof *event);
+  event->source = BF63112_SPI_IRQ_SOURCE_SYSFS;
+  event->edge = -1;
+  event->value = -1;
+  event->observed = false;
+
+  started = default_now_ms (NULL);
+  pfd.fd = state->value_fd;
+  pfd.events = POLLPRI | POLLERR;
+  pfd.revents = 0;
+  do
+    rc = poll (&pfd, 1, (int) timeout_ms);
+  while (rc < 0 && errno == EINTR);
+  event->elapsed_ms = default_now_ms (NULL) - started;
+  if (rc < 0)
+    return neg_errno ();
+  if (rc == 0 || pfd.revents == 0)
+    return BF63112_SPI_ERR_TIMEOUT;
+
+  snprintf (path, sizeof path, "%s/gpio%d/value", state->base, state->line);
+  raw = read_sysfs_int (path);
+  if (raw < 0)
+    return raw;
+  value = raw;
+  if (state->active_low && !state->hw_active_low)
+    value = 1 - value;
+
+  event->observed = true;
+  event->value = value;
+  if (value != state->last_value)
+    event->edge = value > state->last_value ? 1 : 0;
+  state->last_value = value;
+  return 0;
+}
+
+static void
+sysfs_irq_close (struct bf63112_spi_irq *irq)
+{
+  struct bf63112_sysfs_irq *state = irq->priv;
+  char path[320];
+
+  if (state == NULL)
+    return;
+  if (state->value_fd >= 0)
+    {
+      close (state->value_fd);
+      state->value_fd = -1;
+    }
+  if (state->exported_here)
+    {
+      snprintf (path, sizeof path, "%s/unexport", state->base);
+      (void) write_sysfs_int (path, state->line);
+      state->exported_here = false;
+    }
+}
+
+int
+bf63112_spi_irq_sysfs_init (struct bf63112_spi_irq *irq,
+                            struct bf63112_sysfs_irq *state,
+                            int line, int edge, bool active_low,
+                            const char *sysfs_base)
+{
+  size_t len;
+
+  if (irq == NULL || state == NULL || line < 0 ||
+      (edge != BF63112_SPI_IRQ_RISING && edge != BF63112_SPI_IRQ_FALLING &&
+       edge != BF63112_SPI_IRQ_BOTH))
+    return BF63112_SPI_ERR_INVALID;
+  if (sysfs_base == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  len = strlen (sysfs_base);
+  if (len >= sizeof state->base)
+    return BF63112_SPI_ERR_INVALID;
+  memset (state, 0, sizeof *state);
+  memcpy (state->base, sysfs_base, len + 1);
+  state->line = line;
+  state->edge = edge;
+  state->active_low = active_low;
+  state->value_fd = -1;
+  state->last_value = -1;
+  irq->open = sysfs_irq_open;
+  irq->wait = sysfs_irq_wait;
+  irq->close = sysfs_irq_close;
+  irq->priv = state;
+  return 0;
+}
+
+/* ---------------------------------------------------------------- poll IRQ */
+
+static int
+poll_irq_open (struct bf63112_spi_irq *irq)
+{
+  (void) irq;
+  return 0;
+}
+
+static int
+poll_irq_wait (struct bf63112_spi_irq *irq, unsigned int timeout_ms,
+               struct bf63112_spi_irq_event *event)
+{
+  struct bf63112_poll_irq *state = irq->priv;
+
+  if (state == NULL || event == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  memset (event, 0, sizeof *event);
+  event->source = BF63112_SPI_IRQ_SOURCE_POLL;
+  event->observed = false;
+  event->edge = -1;
+  event->value = -1;
+  event->elapsed_ms = timeout_ms;
+  if (state->sleep_ms != NULL)
+    state->sleep_ms (timeout_ms, state->sleep_ctx);
+  else
+    default_sleep_ms (timeout_ms, NULL);
+  return 0;
+}
+
+static void
+poll_irq_close (struct bf63112_spi_irq *irq)
+{
+  (void) irq;
+}
+
+int
+bf63112_spi_irq_poll_init (struct bf63112_spi_irq *irq,
+                           struct bf63112_poll_irq *state,
+                           void (*sleep_ms) (unsigned int, void *),
+                           void *sleep_ctx)
+{
+  if (irq == NULL || state == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  memset (state, 0, sizeof *state);
+  state->sleep_ms = sleep_ms;
+  state->sleep_ctx = sleep_ctx;
+  irq->open = poll_irq_open;
+  irq->wait = poll_irq_wait;
+  irq->close = poll_irq_close;
+  irq->priv = state;
+  return 0;
+}
+
+/* -------------------------------------------------------------- sysfs reset */
+
+static int
+sysfs_reset_open (struct bf63112_spi_reset *reset)
+{
+  struct bf63112_sysfs_reset *state = reset->priv;
+  char path[320];
+  int rc;
+
+  if (state == NULL || state->line < 0)
+    return BF63112_SPI_ERR_INVALID;
+  if (!path_is_dir (state->base))
+    return BF63112_SPI_ERR_IO;
+  snprintf (path, sizeof path, "%s/gpio%d", state->base, state->line);
+  if (!path_is_dir (path))
+    {
+      snprintf (path, sizeof path, "%s/export", state->base);
+      rc = write_sysfs_int (path, state->line);
+      if (rc != 0)
+        return rc;
+      state->exported_here = true;
+      snprintf (path, sizeof path, "%s/gpio%d", state->base, state->line);
+      if (!wait_for_path (path, 500))
+        return BF63112_SPI_ERR_TIMEOUT;
+    }
+  snprintf (path, sizeof path, "%s/gpio%d/direction", state->base,
+            state->line);
+  rc = write_sysfs (path, "out");
+  if (rc != 0)
+    return rc;
+  state->hw_active_low = false;
+  snprintf (path, sizeof path, "%s/gpio%d/active_low", state->base,
+            state->line);
+  if (access (path, F_OK) == 0)
+    {
+      rc = write_sysfs (path, state->active_low ? "1" : "0");
+      if (rc == 0)
+        state->hw_active_low = true;
+    }
+  return 0;
+}
+
+static int
+sysfs_reset_set (struct bf63112_spi_reset *reset, int logical)
+{
+  struct bf63112_sysfs_reset *state = reset->priv;
+  char path[320];
+  int physical = logical ? 1 : 0;
+
+  if (state == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  if (state->active_low && !state->hw_active_low)
+    physical = 1 - physical;
+  snprintf (path, sizeof path, "%s/gpio%d/value", state->base, state->line);
+  return write_sysfs (path, physical ? "1" : "0");
+}
+
+static void
+sysfs_reset_close (struct bf63112_spi_reset *reset)
+{
+  struct bf63112_sysfs_reset *state = reset->priv;
+  char path[320];
+
+  if (state == NULL)
+    return;
+  if (state->exported_here)
+    {
+      snprintf (path, sizeof path, "%s/unexport", state->base);
+      (void) write_sysfs_int (path, state->line);
+      state->exported_here = false;
+    }
+}
+
+int
+bf63112_spi_reset_sysfs_init (struct bf63112_spi_reset *reset,
+                              struct bf63112_sysfs_reset *state,
+                              int line, bool active_low,
+                              const char *sysfs_base)
+{
+  size_t len;
+
+  if (reset == NULL || state == NULL || line < 0 || sysfs_base == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  len = strlen (sysfs_base);
+  if (len >= sizeof state->base)
+    return BF63112_SPI_ERR_INVALID;
+  memset (state, 0, sizeof *state);
+  memcpy (state->base, sysfs_base, len + 1);
+  state->line = line;
+  state->active_low = active_low;
+  reset->open = sysfs_reset_open;
+  reset->set = sysfs_reset_set;
+  reset->close = sysfs_reset_close;
+  reset->priv = state;
+  reset->active_low = active_low;
+  return 0;
+}
+
+/* --------------------------------------------------------- libgpiod v2 */
+
+#if defined(BF63112_HAVE_GPIOD_V2)
+
+struct bf63112_gpiod_irq
+{
+  char chip_path[256];
+  unsigned int offset;
+  int edge;
+  bool active_low;
+  struct gpiod_chip *chip;
+  struct gpiod_line_request *request;
+  struct gpiod_edge_event_buffer *events;
+};
+
+struct bf63112_gpiod_reset
+{
+  char chip_path[256];
+  unsigned int offset;
+  bool active_low;
+  struct gpiod_chip *chip;
+  struct gpiod_line_request *request;
+};
+
+static enum gpiod_line_edge
+gpiod_edge (int edge)
+{
+  switch (edge)
+    {
+    case BF63112_SPI_IRQ_FALLING:
+      return GPIOD_LINE_EDGE_FALLING;
+    case BF63112_SPI_IRQ_BOTH:
+      return GPIOD_LINE_EDGE_BOTH;
+    case BF63112_SPI_IRQ_RISING:
+    default:
+      return GPIOD_LINE_EDGE_RISING;
+    }
+}
+
+static void
+gpiod_irq_release (struct bf63112_gpiod_irq *state)
+{
+  if (state->request != NULL)
+    {
+      gpiod_line_request_release (state->request);
+      state->request = NULL;
+    }
+  if (state->events != NULL)
+    {
+      gpiod_edge_event_buffer_free (state->events);
+      state->events = NULL;
+    }
+  if (state->chip != NULL)
+    {
+      gpiod_chip_close (state->chip);
+      state->chip = NULL;
+    }
+}
+
+static int
+gpiod_irq_open (struct bf63112_spi_irq *irq)
+{
+  struct bf63112_gpiod_irq *state = irq->priv;
+  struct gpiod_line_settings *settings = NULL;
+  struct gpiod_line_config *line_cfg = NULL;
+  struct gpiod_request_config *req_cfg = NULL;
+
+  if (state == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  if (state->request != NULL)
+    return 0;
+  state->chip = gpiod_chip_open (state->chip_path);
+  if (state->chip == NULL)
+    goto fail;
+  settings = gpiod_line_settings_new ();
+  if (settings == NULL)
+    goto fail;
+  if (gpiod_line_settings_set_direction (settings,
+                                         GPIOD_LINE_DIRECTION_INPUT) < 0)
+    goto fail;
+  if (gpiod_line_settings_set_edge_detection (settings,
+                                              gpiod_edge (state->edge)) < 0)
+    goto fail;
+  gpiod_line_settings_set_active_low (settings, state->active_low);
+  line_cfg = gpiod_line_config_new ();
+  if (line_cfg == NULL)
+    goto fail;
+  if (gpiod_line_config_add_line_settings (line_cfg, &state->offset, 1,
+                                           settings) < 0)
+    goto fail;
+  req_cfg = gpiod_request_config_new ();
+  if (req_cfg == NULL)
+    goto fail;
+  gpiod_request_config_set_consumer (req_cfg, "bf63112");
+  state->request = gpiod_chip_request_lines (state->chip, req_cfg, line_cfg);
+  if (state->request == NULL)
+    goto fail;
+  state->events = gpiod_edge_event_buffer_new (16);
+  if (state->events == NULL)
+    goto fail;
+  gpiod_line_settings_free (settings);
+  gpiod_line_config_free (line_cfg);
+  gpiod_request_config_free (req_cfg);
+  return 0;
+
+fail:
+  if (settings != NULL)
+    gpiod_line_settings_free (settings);
+  if (line_cfg != NULL)
+    gpiod_line_config_free (line_cfg);
+  if (req_cfg != NULL)
+    gpiod_request_config_free (req_cfg);
+  gpiod_irq_release (state);
+  return BF63112_SPI_ERR_IO;
+}
+
+static int
+gpiod_irq_wait (struct bf63112_spi_irq *irq, unsigned int timeout_ms,
+                struct bf63112_spi_irq_event *event)
+{
+  struct bf63112_gpiod_irq *state = irq->priv;
+  struct gpiod_edge_event *edge_event;
+  int64_t timeout_ns;
+  uint64_t started;
+  int rc, n;
+
+  if (state == NULL || state->request == NULL || event == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  memset (event, 0, sizeof *event);
+  event->source = BF63112_SPI_IRQ_SOURCE_GPIOD;
+  event->edge = -1;
+  event->value = -1;
+  event->observed = false;
+  timeout_ns = (int64_t) timeout_ms * 1000000;
+  started = default_now_ms (NULL);
+  do
+    rc = gpiod_line_request_wait_edge_events (state->request, timeout_ns);
+  while (rc < 0 && errno == EINTR);
+  event->elapsed_ms = default_now_ms (NULL) - started;
+  if (rc < 0)
+    return neg_errno ();
+  if (rc == 0)
+    return BF63112_SPI_ERR_TIMEOUT;
+  n = gpiod_line_request_read_edge_events (state->request, state->events, 16);
+  if (n <= 0)
+    return n < 0 ? neg_errno () : BF63112_SPI_ERR_IO;
+  edge_event = gpiod_edge_event_buffer_get_event (state->events, 0);
+  if (edge_event == NULL)
+    return BF63112_SPI_ERR_IO;
+  event->edge =
+    gpiod_edge_event_get_event_type (edge_event) ==
+    GPIOD_EDGE_EVENT_RISING_EDGE ? 1 : 0;
+  event->observed = true;
+  return 0;
+}
+
+static void
+gpiod_irq_close (struct bf63112_spi_irq *irq)
+{
+  struct bf63112_gpiod_irq *state = irq->priv;
+
+  if (state != NULL)
+    gpiod_irq_release (state);
+}
+
+int
+bf63112_spi_irq_gpiod_init (struct bf63112_spi_irq *irq,
+                            struct bf63112_gpiod_irq **state_out,
+                            int line, int edge, bool active_low,
+                            const char *chip)
+{
+  struct bf63112_gpiod_irq *state;
+  size_t len;
+
+  if (irq == NULL || state_out == NULL || line < 0 || chip == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  len = strlen (chip);
+  if (len >= sizeof state->chip_path)
+    return BF63112_SPI_ERR_INVALID;
+  state = calloc (1, sizeof *state);
+  if (state == NULL)
+    return BF63112_SPI_ERR_NO_SPACE;
+  memcpy (state->chip_path, chip, len + 1);
+  state->offset = (unsigned int) line;
+  state->edge = edge;
+  state->active_low = active_low;
+  irq->open = gpiod_irq_open;
+  irq->wait = gpiod_irq_wait;
+  irq->close = gpiod_irq_close;
+  irq->priv = state;
+  *state_out = state;
+  return 0;
+}
+
+static int
+gpiod_reset_open (struct bf63112_spi_reset *reset)
+{
+  struct bf63112_gpiod_reset *state = reset->priv;
+  struct gpiod_line_settings *settings = NULL;
+  struct gpiod_line_config *line_cfg = NULL;
+  struct gpiod_request_config *req_cfg = NULL;
+
+  if (state == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  if (state->request != NULL)
+    return 0;
+  state->chip = gpiod_chip_open (state->chip_path);
+  if (state->chip == NULL)
+    goto fail;
+  settings = gpiod_line_settings_new ();
+  if (settings == NULL)
+    goto fail;
+  if (gpiod_line_settings_set_direction (settings,
+                                         GPIOD_LINE_DIRECTION_OUTPUT) < 0)
+    goto fail;
+  if (gpiod_line_settings_set_output_value (settings,
+                                            GPIOD_LINE_VALUE_INACTIVE) < 0)
+    goto fail;
+  gpiod_line_settings_set_active_low (settings, state->active_low);
+  line_cfg = gpiod_line_config_new ();
+  if (line_cfg == NULL)
+    goto fail;
+  if (gpiod_line_config_add_line_settings (line_cfg, &state->offset, 1,
+                                           settings) < 0)
+    goto fail;
+  req_cfg = gpiod_request_config_new ();
+  if (req_cfg == NULL)
+    goto fail;
+  gpiod_request_config_set_consumer (req_cfg, "bf63112-reset");
+  state->request = gpiod_chip_request_lines (state->chip, req_cfg, line_cfg);
+  if (state->request == NULL)
+    goto fail;
+  gpiod_line_settings_free (settings);
+  gpiod_line_config_free (line_cfg);
+  gpiod_request_config_free (req_cfg);
+  return 0;
+
+fail:
+  if (settings != NULL)
+    gpiod_line_settings_free (settings);
+  if (line_cfg != NULL)
+    gpiod_line_config_free (line_cfg);
+  if (req_cfg != NULL)
+    gpiod_request_config_free (req_cfg);
+  if (state->request != NULL)
+    {
+      gpiod_line_request_release (state->request);
+      state->request = NULL;
+    }
+  if (state->chip != NULL)
+    {
+      gpiod_chip_close (state->chip);
+      state->chip = NULL;
+    }
+  return BF63112_SPI_ERR_IO;
+}
+
+static int
+gpiod_reset_set (struct bf63112_spi_reset *reset, int logical)
+{
+  struct bf63112_gpiod_reset *state = reset->priv;
+
+  if (state == NULL || state->request == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  return gpiod_line_request_set_value (
+           state->request, state->offset,
+           logical ? GPIOD_LINE_VALUE_ACTIVE : GPIOD_LINE_VALUE_INACTIVE) < 0
+         ? neg_errno () : 0;
+}
+
+static void
+gpiod_reset_close (struct bf63112_spi_reset *reset)
+{
+  struct bf63112_gpiod_reset *state = reset->priv;
+
+  if (state == NULL)
+    return;
+  if (state->request != NULL)
+    {
+      gpiod_line_request_release (state->request);
+      state->request = NULL;
+    }
+  if (state->chip != NULL)
+    {
+      gpiod_chip_close (state->chip);
+      state->chip = NULL;
+    }
+}
+
+int
+bf63112_spi_reset_gpiod_init (struct bf63112_spi_reset *reset,
+                              struct bf63112_gpiod_reset **state_out,
+                              int line, bool active_low,
+                              const char *chip)
+{
+  struct bf63112_gpiod_reset *state;
+  size_t len;
+
+  if (reset == NULL || state_out == NULL || line < 0 || chip == NULL)
+    return BF63112_SPI_ERR_INVALID;
+  len = strlen (chip);
+  if (len >= sizeof state->chip_path)
+    return BF63112_SPI_ERR_INVALID;
+  state = calloc (1, sizeof *state);
+  if (state == NULL)
+    return BF63112_SPI_ERR_NO_SPACE;
+  memcpy (state->chip_path, chip, len + 1);
+  state->offset = (unsigned int) line;
+  state->active_low = active_low;
+  reset->open = gpiod_reset_open;
+  reset->set = gpiod_reset_set;
+  reset->close = gpiod_reset_close;
+  reset->priv = state;
+  reset->active_low = active_low;
+  *state_out = state;
+  return 0;
+}
