+  if (state->line == NULL)
+    return BF63112_SPI_ERR_IO;
+  if (gpiod_line_request_output_flags (state->line, "bf63112-reset", flags,
+                                       0) < 0)
+    return BF63112_SPI_ERR_IO;
+  return 0;
+}
+
+static int
+gpiod_reset_set (struct bf63112_spi_reset *reset, int logical)
