{
  "name": "decky-oxp3-status",
  "version": "1.0.0",
  "description": "Decky Loader plugin: live status of the OneXPlayer 3 (OXP3) Anatase fixes for the running game",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "oxp3",
    "onexplayer",
    "anatase",
    "status"
  ],
  "author": "silentsudin",
  "dependencies": {
    "@decky/api": "^1.1.2",
    "@decky/ui": "^4.7.2"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "rollup": "^4.22.5",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
