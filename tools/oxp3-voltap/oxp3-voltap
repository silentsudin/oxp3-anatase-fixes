def cmd_check(cfg) -> int:
    plan, devices, holders, hstats = _load_plan(cfg)
    if not devices:
        log("no input event devices discovered from "
            f"{cfg.proc_root}/bus/input/devices or {cfg.sys_root}/class/input")
    if cfg.format == "json":
        print(json.dumps(plan_json(plan), indent=2, sort_keys=True))
    elif cfg.format == "kv":
        print(format_kv(plan, hstats["known"]))
    else:
        print(format_check(plan, hstats["known"]))
    return plan["predicted_exit"]


def cmd_explain(cfg) -> int:
    plan, devices, holders, hstats = _load_plan(cfg)
    if cfg.format == "json":
        print(json.dumps(plan_json(plan), indent=2, sort_keys=True))
    elif cfg.format == "kv":
        print(format_kv(plan, hstats["known"]))
    else:
        print(format_explain(plan, hstats["known"]))
    return plan["predicted_exit"]


def cmd_status(cfg) -> int:
    text = _read_text(cfg.status_file)
    if text is None:
        print(f"no status file at {cfg.status_file} "
              f"(is oxp3-voltap running?)")
        return EXIT_NO_DEVICE
    if cfg.format == "json":
        print(text.rstrip())
        return EXIT_OK
    try:
        data = json.loads(text)
    except ValueError as exc:
        log(f"status file {cfg.status_file} is not valid JSON: {exc}")
        return EXIT_USAGE
    selected = data.get("selected") or {}
    print(f"state:    {data.get('state')} (exit {data.get('exit_code')})")
    print(f"topology: {data.get('topology')}")
    print(f"selected: {selected.get('path', '-')} "
          f"({selected.get('name', '')!r} role={selected.get('role', '-')})")
    print(f"reason:   {data.get('reason', '')}")
    if data.get("observe") or data.get("state") == "degraded-hhd-protected":
        print("mode:     observe/degraded-hhd-protected (hhd owns the volume "
              "path; nothing opened or grabbed)")
    print(f"hhd:      running={data.get('hhd', {}).get('running')} "
          f"pids={data.get('hhd', {}).get('pids', [])} "
          f"protected={data.get('hhd_protected')} "
          f"allow_hhd_grab={data.get('allow_hhd_grab')}")
    if data.get("refused"):
        print("refused:  " + "; ".join(
            f"{item.get('path')}: {item.get('detail', item.get('kind'))}"
            for item in data["refused"]))
    if not data.get("holders_known", True):
        print("holders:  incomplete (the daemon runs as root and sees all)")
    age = int(time.time()) - int(data.get("time", 0))
    print(f"updated:  {age}s ago")
    return EXIT_OK


def cmd_selftest(cfg) -> int:
    if not have_root():
        log("selftest needs root (/dev/uinput)")
        return EXIT_USAGE
    ui = UInput({ecodes.EV_KEY: list(VOLUME_CODES)}, name=SHIM_NAME,
                phys=SHIM_PHYS, version=1, vendor=SHIM_VID,
                product=SHIM_PID, bustype=ecodes.BUS_USB)
    time.sleep(0.4)
    node = getattr(ui.device, "path", "?")
    log(f"created {node}; emitting 2 taps, 300 ms apart")
    for _ in range(2):
        ui.write(ecodes.EV_KEY, ecodes.KEY_VOLUMEUP, 1)
        ui.syn()
        time.sleep(cfg.hold)
        ui.write(ecodes.EV_KEY, ecodes.KEY_VOLUMEUP, 0)
        ui.syn()
        time.sleep(0.3)
    ui.close()
    log("selftest done")
    return EXIT_OK


# --------------------------------------------------------------------------
def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        prog="oxp3-voltap",
        description="normalise the ONEXPLAYER 3 volume rocker into discrete "
                    "taps")
    parser.add_argument("mode", nargs="?", default="run",
                        choices=("run", "probe", "check", "explain",
                                 "diagnose", "status", "selftest"))
    parser.add_argument("--device", action="append", default=[],
                        metavar="PATH",
                        help="explicit /dev/input/eventN (repeatable; wins "
                             "over automatic topology discovery)")
    parser.add_argument("--name", default=os.environ.get("VOLTAP_NAME", ""),
                        help="extra regex on the device name to prefer")
    parser.add_argument("--phys", default=os.environ.get("VOLTAP_PHYS", ""),
                        help="extra regex on the device phys to prefer")
    parser.add_argument("--prefer", choices=("auto", "hhd-virtual", "physical"),
                        default=os.environ.get("VOLTAP_PREFER", "auto"),
                        help="automatic topology preference (default auto: "
                             "physical AT keyboard when free; hhd's virtual "
                             "device only with --allow-hhd-grab)")
    parser.add_argument("--allow-hhd-grab", dest="allow_hhd_grab",
                        action="store_true",
                        default=os.environ.get("VOLTAP_ALLOW_HHD_GRAB",
                                               "0") not in ("0", "no", "off"),
                        help="DANGEROUS last resort: allow EVIOCGRAB on hhd's "
                             "own virtual volume keyboard. hhd needs that device "
                             "and drops the controller (EBUSY) while we hold "
                             "it; the supported path is the hhd plugin")
    parser.add_argument("--hhd-name",
                        default=os.environ.get(
                            "VOLTAP_HHD_NAME",
                            "Handheld Daemon Volume Keyboard"),
                        help="regex identifying hhd's virtual volume keyboard")
    parser.add_argument("--hhd-phys",
                        default=os.environ.get("VOLTAP_HHD_PHYS", "hhd-vbtn"),
                        help="regex identifying hhd's virtual volume keyboard "
                             "by phys")
    parser.add_argument("--atkbd-name",
                        default=os.environ.get(
                            "VOLTAP_ATKBD_NAME",
                            "AT Translated Set 2 keyboard"),
                        help="regex identifying the physical AT keyboard")
    parser.add_argument("--atkbd-phys",
                        default=os.environ.get("VOLTAP_ATKBD_PHYS",
                                               "isa0060/serio0"),
                        help="regex identifying the physical AT keyboard by phys")
    parser.add_argument("--no-physical", dest="allow_physical",
                        action="store_false",
                        default=os.environ.get("VOLTAP_ALLOW_PHYSICAL",
                                               "1") not in ("0", "no", "off"),
                        help="never fall back to the physical AT keyboard")
    parser.add_argument("--hold", type=float,
                        default=float(os.environ.get("VOLTAP_HOLD_MS", 30)) / 1000,
                        help="ms the synthetic press is held (default 30)")
    parser.add_argument("--gap", type=float,
                        default=float(os.environ.get("VOLTAP_GAP_MS", 60)) / 1000,
                        help="ms after a tap in which a press counts as bounce "
                             "(default 60)")
    parser.add_argument("--max-hold", type=float,
                        default=float(os.environ.get("VOLTAP_MAX_HOLD_MS",
                                                     500)) / 1000,
                        help="ms watchdog for a press that never ended")
    parser.add_argument("--rescan", type=float,
                        default=float(os.environ.get("VOLTAP_RESCAN_S", 1.0)),
                        help="seconds between device rescans (default 1)")
    parser.add_argument("--stats", type=float,
                        default=float(os.environ.get("VOLTAP_STATS", 0)),
                        help="print counters every N seconds (0 = off)")
    parser.add_argument("--duration", type=float,
                        default=float(os.environ.get("VOLTAP_DURATION", 0)),
                        help="probe/diagnose: stop after N seconds "
                             "(probe 0 = until Ctrl-C; diagnose default 5)")
    parser.add_argument("--limit", type=int, default=0,
                        help="probe: stop after N presses (0 = no limit)")
    parser.add_argument("--orphan-tap", dest="orphan_tap", action="store_true",
                        default=os.environ.get("VOLTAP_ORPHAN_TAP",
                                               "1") not in ("0", "no", "off"),
                        help="treat a release without a press as one physical "
                             "press (default on; --no-orphan-tap disables)")
    parser.add_argument("--no-orphan-tap", dest="orphan_tap",
                        action="store_false",
                        help="drop releases that have no matching press")
    parser.add_argument("--stuck-ms", type=float, default=400.0,
                        help="probe: a hold longer than this counts as stuck "
                             "(default 400)")
    parser.add_argument("--grab", action="store_true",
                        help="probe: grab the device (input goes only to the "
                             "probe)")
    parser.add_argument("--once", action="store_true",
                        help="run: one scan, then exit with the documented "
                             "code (0 grabbed, 2 no device, 3 refused, "
                             "4 hhd-protected observe)")
    parser.add_argument("--degrade-exit-after", type=float,
                        default=float(os.environ.get(
                            "VOLTAP_DEGRADE_EXIT_S", 0)),
                        help="run: exit with the degraded/observe code after N "
                             "seconds without a grab (0 = keep retrying)")
    parser.add_argument("--status-file",
                        default=os.environ.get("VOLTAP_STATUS_FILE",
                                               DEFAULT_STATUS_FILE),
                        help="run: JSON status path "
                             f"(default {DEFAULT_STATUS_FILE})")
    parser.add_argument("--proc-root",
                        default=os.environ.get("VOLTAP_PROC_ROOT", "/proc"),
                        help="procfs root (tests)")
    parser.add_argument("--sys-root",
                        default=os.environ.get("VOLTAP_SYS_ROOT", "/sys"),
                        help="sysfs root (tests)")
    parser.add_argument("--probe", dest="probe_flag", action="store_true",
                        help="explain every candidate's suitability and exit "
                             "(alias for the explain mode)")
    parser.add_argument("--json", action="store_true",
                        help="check/explain/status: machine-readable JSON")
    parser.add_argument("--kv", action="store_true",
                        help="check/explain: stable KEY=value lines for the "
                             "verification harness")
    parser.add_argument("--version", action="version",
                        version=f"oxp3-voltap {VERSION}")
    cfg = parser.parse_args(argv)

    env_dev = os.environ.get("VOLTAP_DEVICES", "auto").split()
    if env_dev and env_dev != ["auto"] and not cfg.device:
        cfg.device = env_dev
    cfg.devices = cfg.device
    if cfg.json and cfg.kv:
        parser.error("--json and --kv are mutually exclusive")
    cfg.format = "json" if cfg.json else ("kv" if cfg.kv else "text")

    if cfg.probe_flag and cfg.mode == "run":
        cfg.mode = "explain"
    handlers = {
        "run": cmd_run, "probe": cmd_probe, "check": cmd_check,
        "explain": cmd_explain, "diagnose": cmd_diagnose,
        "status": cmd_status, "selftest": cmd_selftest,
    }
    return handlers[cfg.mode](cfg)


if __name__ == "__main__":
    sys.exit(main())
