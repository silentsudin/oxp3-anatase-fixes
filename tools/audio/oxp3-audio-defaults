#!/bin/bash
# SPDX-License-Identifier: MIT
# Keep the internal microphone selectable as the default source.
#
# The speaker EQ chain exposes its sink monitor as a PipeWire source; WirePlumber
# gives that monitor a high session priority, so it wins the default-source race
# and apps see "no microphone" even though HiFi__Mic1__source exists. This runs at
# login (and can be re-run any time): it only acts when the default source is a
# monitor or empty, so a source the user picked is never overridden.
set -uo pipefail
command -v pactl >/dev/null 2>&1 || exit 0
command -v pw-metadata >/dev/null 2>&1 || exit 0
cur=$(pactl get-default-source 2>/dev/null || true)
case $cur in
    *.monitor|"") ;;
    *) exit 0 ;;
esac
mic=$(pactl list short sources 2>/dev/null | awk '$2 ~ /^alsa_input/ && $2 !~ /monitor/ {print $2; exit}')
[ -n "$mic" ] || exit 0
pw-metadata -n default 0 default.audio.source "{\"name\":\"$mic\"}" >/dev/null 2>&1 || true
logger -t oxp3-audio-defaults "default source set to $mic (was ${cur:-none})" 2>/dev/null || true
