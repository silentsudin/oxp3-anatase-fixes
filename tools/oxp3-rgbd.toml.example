# OneXPlayer 3 body RGB - persistent user config for tools/oxp3-rgbd.py
#
# OPT-IN: HHD is the default owner of all five RGB zones (left stick 0x01,
# right stick 0x02, G-key 0x05, top 0x06, connector 0x07) and applies one
# global mode/colour.  This file only exists when you install the per-zone
# daemon on purpose (oxp3-hw-install.sh --rgb-daemon); any zone listed below
# stops following HHD because the daemon re-applies it.  Hand the zones back
# with tools/oxp3-rgb-handback.sh.
#
# Install:
#   install -m 0644 tools/oxp3-rgbd.toml.example ~/.config/oxp3-rgb.toml
#   $EDITOR ~/.config/oxp3-rgb.toml
#   systemctl --user restart oxp3-rgbd.service
#
# Only the zones listed here are touched.  Delete a [zones.*] block to hand
# that physical zone back to HHD / the firmware.
#
# Zone keys (firmware side ids, = vendor pcode):
#   left_stick = 0x01   right_stick = 0x02   gkey = 0x05
#   top        = 0x06   connector   = 0x07
#   ("03"/"04" are V-zone/keyboard on other OneXPlayer models.)
#
# effect: solid | breath | preset | off
#   solid   - static colour
#   breath  - breathing animation of one colour (firmware 0xF0)
#   preset  - hardware animation by name or vendor id 1..11
#   off     - disable the zone
#
# preset names: monster_woke, flowing, sunset, neon, dreamy, cyberpunk,
#   colorful, aok_classic, oxp_classic, aurora, warm_sun (or 1..11)
#
# brightness / level: keep | low | mid | medium | high
#   "keep" leaves HHD's brightness alone and only writes colours/presets.

[global]
brightness = "high"

[zones.left_stick]
effect = "solid"
color = "#ff6600"

[zones.right_stick]
effect = "solid"
color = "#ff6600"

[zones.gkey]
effect = "breath"
color = "#3050ff"

[zones.top]
effect = "preset"
preset = "aurora"

[zones.connector]
effect = "solid"
color = "#ff6600"
level = "medium"
