    <!-- Anti-cheat titles and the runtime/overlay processes they depend on are
         deliberately left on all CPUs (0-13).  Restricting them to P+E has
         crashed Elden Ring at startup (EAC/Proton/MangoHud). -->
    <Process>
        <Name>eldenring.exe</Name>
        <ActiveCores>0-13</ActiveCores>
        <Classification>custom_profile_0</Classification>
    </Process>
    <Process>
        <Name>start_protected*</Name>
        <ActiveCores>0-13</ActiveCores>
        <Classification>custom_profile_0</Classification>
    </Process>
    <Process>
        <Name>EasyAntiCheat*</Name>
        <ActiveCores>0-13</ActiveCores>
        <Classification>custom_profile_0</Classification>
    </Process>
