    <!-- Anti-cheat titles and the Steam/Wine runtime they depend on are left on
         all CPUs (0-13): restricting them to P+E crashes Elden Ring at start. -->
    <Process>
        <Name>eldenring.exe</Name>
        <ActiveCores>0-13</ActiveCores>
        <AllowSession>1</AllowSession>
        <Classification>custom_profile_0</Classification>
    </Process>
